---
import ChartsTile from "@/components/measurements/ChartsTile.astro";
import type { ChartBody } from "@/components/measurements/MeasurementCharts";
import type { ChartPeriod } from "@/lib/measurement-chart";
import MeasurementBrowser from "@/components/measurements/MeasurementBrowser";
import PageErrorToasts from "@/components/measurements/PageErrorToasts";
import LinkedTraineeField from "@/components/trainer/LinkedTraineeField";
import TraineeEmailSearch from "@/components/trainer/TraineeEmailSearch";
import { Button } from "@/components/ui/button";
import { requestOutcomeMessage } from "@/lib/collaborations";
import { addFormStartsOpen, type PageSize } from "@/lib/measurement-page";
import type { TrainerLink } from "@/lib/trainer-preview";
import type { MeasurementWithDeltas } from "@/types";

interface Props {
  mode: "trainer" | "unavailable";
  serverError: string | null;
  requestedEmail: string | null;
  trainerLinksLoaded: boolean;
  trainerLinks: TrainerLink[];
  selectedLink: TrainerLink | null;
  trainerMeasurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  idPrefix?: string;
  accountUserId?: string;
  today?: string;
  dates?: string[];
  page?: number;
  pageCount?: number;
  pageSize?: PageSize;
  month?: string;
  chartsOpen?: boolean | null;
  chartsPeriod?: ChartPeriod;
  chartsAnchor?: string | null;
  /** The server's chart read and entry days for the tile's first render. */
  chartInitial?: ChartBody | null;
  chartDays?: string[] | null;
  /** Kitchen-sink local mode for the charts tile. */
  chartEntries?: MeasurementWithDeltas[];
}

const {
  mode,
  serverError,
  requestedEmail,
  trainerLinksLoaded,
  trainerLinks,
  selectedLink,
  trainerMeasurementsLoaded,
  entries,
  idPrefix = "",
  accountUserId,
  today,
  dates,
  page,
  pageCount,
  pageSize,
  month,
  chartsOpen = null,
  chartsPeriod,
  chartsAnchor = null,
  chartInitial = null,
  chartDays = null,
  chartEntries,
} = Astro.props;

const toastMessages: string[] = [];
if (serverError !== null && serverError !== "Enter an email address") {
  toastMessages.push(serverError);
}
if (mode === "trainer" && !trainerLinksLoaded) {
  toastMessages.push("Could not load trainees");
}
if (mode === "trainer" && trainerLinksLoaded && selectedLink !== null && !trainerMeasurementsLoaded) {
  toastMessages.push("Could not load measurements");
}
if (mode !== "trainer") {
  toastMessages.push("Could not open your journal");
}
const chartsStartOpen = addFormStartsOpen(false, chartsOpen);
const showCharts = accountUserId !== undefined || chartEntries !== undefined;
const requestNotice =
  mode === "trainer" && requestedEmail !== null ? requestOutcomeMessage("sent", requestedEmail) : null;
---

<div class="flex justify-center px-4 pb-4">
  <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
    {toastMessages.length > 0 ? <PageErrorToasts messages={toastMessages} client:load /> : null}
    {requestNotice !== null ? (
      <PageErrorToasts messages={[requestNotice]} tone="notice" clearParams={["requested"]} client:load />
    ) : null}
    {mode === "trainer" ? (
      <>
        {trainerLinksLoaded ? (
          <>
            <form method="POST" action="/api/trainer-links" class="space-y-3">
              {selectedLink ? <input type="hidden" name="trainee" value={selectedLink.traineeId} /> : null}
              <TraineeEmailSearch idPrefix={idPrefix} serverError={serverError} client:load />
              <Button type="submit" className="w-full">
                Request read access
              </Button>
            </form>
            {trainerLinks.length > 0 ? (
              <>
                <h2 class="mt-6 mb-3 text-xl font-bold text-foreground">Body measurements</h2>
                <div class="flex justify-center">
                  {selectedLink ? (
                    <LinkedTraineeField links={trainerLinks} selectedTraineeId={selectedLink.traineeId} client:load />
                  ) : null}
                </div>
                {selectedLink ? (
                  trainerMeasurementsLoaded ? (
                    <MeasurementBrowser
                      entries={entries}
                      readOnly={true}
                      accountUserId={accountUserId}
                      subjectTraineeId={selectedLink.traineeId}
                      idPrefix={idPrefix}
                      today={today}
                      dates={dates}
                      page={page}
                      pageCount={pageCount}
                      pageSize={pageSize}
                      month={month}
                      client:load
                    />
                  ) : null
                ) : null}
              </>
            ) : null}
          </>
        ) : null}
      </>
    ) : (
      <>
        <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">Measurements</h1>
      </>
    )}
  </div>
</div>
{mode === "trainer" && trainerLinksLoaded && selectedLink && showCharts ? (
  <ChartsTile
    accountUserId={accountUserId}
    subjectTraineeId={selectedLink.traineeId}
    readOnly={true}
    month={month}
    today={today}
    startsOpen={chartsStartOpen}
    initialPeriod={chartsPeriod}
    initialAnchor={chartsAnchor}
    initialChart={chartInitial}
    initialDays={chartDays}
    entries={chartEntries}
  />
) : null}
