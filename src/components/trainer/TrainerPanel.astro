---
import ChartsTile from "@/components/measurements/ChartsTile.astro";
import CollapsibleTile from "@/components/measurements/CollapsibleTile.astro";
import ComponentsOffCard from "@/components/measurements/ComponentsOffCard.astro";
import TopChangesTile from "@/components/measurements/TopChangesTile.astro";
import type { ChartBody, ComponentTiles } from "@/types";
import type { ChartPeriod } from "@/lib/measurement-chart";
import MeasurementBrowser from "@/components/measurements/MeasurementBrowser";
import PageErrorToasts from "@/components/measurements/PageErrorToasts";
import LinkedTraineeField from "@/components/trainer/LinkedTraineeField";
import { requestOutcomeMessage } from "@/lib/collaborations";
import { tileOf } from "@/lib/components";
import {
  addFormStartsOpen,
  listOpenStorageKey,
  traineePickerOpenStorageKey,
  type PageSize,
} from "@/lib/measurement-page";
import { traineeName, type TrainerLink } from "@/lib/trainer-preview";
import type { CircumferenceField, MeasurementWithDeltas } from "@/types";

interface Props {
  mode: "trainer" | "unavailable";
  serverError: string | null;
  requestedEmail: string | null;
  trainerLinksLoaded: boolean;
  trainerLinks: TrainerLink[];
  selectedLink: TrainerLink | null;
  trainerMeasurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  idPrefix?: string;
  accountUserId?: string;
  today?: string;
  dates?: string[];
  page?: number;
  pageCount?: number;
  pageSize?: PageSize;
  month?: string;
  traineePickerOpen?: boolean | null;
  listOpen?: boolean | null;
  chartsOpen?: boolean | null;
  chartsPeriod?: ChartPeriod;
  chartsAnchor?: string | null;
  /** The server's chart read and entry days for the tile's first render. */
  chartInitial?: ChartBody | null;
  chartDays?: string[] | null;
  topChartsOpen?: boolean | null;
  topChartsPeriod?: ChartPeriod;
  topChartsAnchor?: string | null;
  /** The server's Top progression read for the tile's first render; its picker shares `chartDays`. */
  topChartInitial?: ChartBody | null;
  /** 0.1: the circumferences from the preference cookie; all 7 when absent. */
  topChartsFields?: readonly CircumferenceField[];
  /** 0.9: each circumference chart's fields from its preference cookie; all 7 when absent. */
  topChartsGainFields?: readonly CircumferenceField[];
  topChartsLossFields?: readonly CircumferenceField[];
  /** Kitchen-sink local mode for the charts tile. */
  chartEntries?: MeasurementWithDeltas[];
  /** Which tiles render and which carry a version badge, by the trainer's own settings; every tile when absent. */
  shown?: ComponentTiles;
}

const {
  mode,
  serverError,
  requestedEmail,
  trainerLinksLoaded,
  trainerLinks,
  selectedLink,
  trainerMeasurementsLoaded,
  entries,
  idPrefix = "",
  accountUserId,
  today,
  dates,
  page,
  pageCount,
  pageSize,
  month,
  traineePickerOpen = null,
  listOpen = null,
  chartsOpen = null,
  chartsPeriod,
  chartsAnchor = null,
  chartInitial = null,
  chartDays = null,
  topChartsOpen = null,
  topChartsPeriod,
  topChartsAnchor = null,
  topChartInitial = null,
  topChartsFields,
  topChartsGainFields,
  topChartsLossFields,
  chartEntries,
  shown = {},
} = Astro.props;

const toastMessages: string[] = [];
if (serverError !== null) {
  toastMessages.push(serverError);
}
if (mode === "trainer" && !trainerLinksLoaded) {
  toastMessages.push("Could not load trainees");
}
if (mode === "trainer" && trainerLinksLoaded && selectedLink !== null && !trainerMeasurementsLoaded) {
  toastMessages.push("Could not load measurements");
}
if (mode !== "trainer") {
  toastMessages.push("Could not open your journal");
}
const pickerKey = accountUserId ? traineePickerOpenStorageKey(accountUserId) : null;
const pickerStartsOpen = addFormStartsOpen(false, traineePickerOpen);
const listKey = accountUserId ? listOpenStorageKey(accountUserId) : null;
const listStartsOpen = addFormStartsOpen(false, listOpen);
const chartsStartOpen = addFormStartsOpen(false, chartsOpen);
const topChartsStartOpen = addFormStartsOpen(false, topChartsOpen);
const showCharts = accountUserId !== undefined || chartEntries !== undefined;
// Find trainee lives in the top bar; its setting only decides where the no-trainee card points.
const findTraineeShown = tileOf(shown, "find-trainee").shown;
const pickerTile = tileOf(shown, "trainee-picker");
const listTile = tileOf(shown, "trainee-measurements");
const chartsTile = tileOf(shown, "progression");
const topChartsTile = tileOf(shown, "top-changes");
const tilesRender = mode === "trainer" && trainerLinksLoaded;
const hasTrainee = trainerLinks.length > 0 && selectedLink !== null;
// The picker's note names the chosen trainee: "Ada Lovelace · ada@example.com", or the email alone with no saved name.
let pickerNote: string | undefined;
if (selectedLink !== null) {
  const name = traineeName(selectedLink);
  pickerNote = name === selectedLink.email ? selectedLink.email : `${name} · ${selectedLink.email}`;
}
// Each tile renders only when it is on and has something to show; the picker cannot be switched off.
const pickerRenders = tilesRender && pickerTile.shown && hasTrainee;
const listRenders = tilesRender && listTile.shown && hasTrainee;
const chartsRender = tilesRender && chartsTile.shown && selectedLink !== null && showCharts;
const topChartsRender = tilesRender && topChartsTile.shown && selectedLink !== null && showCharts;
const everyComponentOff = !findTraineeShown && !listTile.shown && !chartsTile.shown && !topChartsTile.shown;
// When none of the switchable tiles can render, one card says why: every component is off (→ Settings → Components),
// or there is no trainee yet whose list or charts could show (→ Find trainee in the top bar, or Settings when it is off).
const nothingRenders = tilesRender && !listRenders && !chartsRender && !topChartsRender;
const componentsOffCard = nothingRenders && everyComponentOff;
const noTraineeCard = nothingRenders && !everyComponentOff && !hasTrainee;
const requestNotice =
  mode === "trainer" && requestedEmail !== null ? requestOutcomeMessage("sent", requestedEmail) : null;
---

{toastMessages.length > 0 ? <PageErrorToasts messages={toastMessages} client:load /> : null}
{requestNotice !== null ? (
  <PageErrorToasts messages={[requestNotice]} tone="notice" clearParams={["requested"]} client:load />
) : null}
{mode === "trainer" ? null : (
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
      <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">Measurements</h1>
    </div>
  </div>
)}
{pickerRenders ? (
  <CollapsibleTile
    storageKey={pickerKey}
    startsOpen={pickerStartsOpen}
    title="Choose trainee"
    note={pickerNote}
    tileId="trainee-picker"
    stage={pickerTile.stage}
  >
    <div class="mt-3 flex justify-center">
      <LinkedTraineeField links={trainerLinks} selectedTraineeId={selectedLink.traineeId} client:load />
    </div>
  </CollapsibleTile>
) : null}
{componentsOffCard ? <ComponentsOffCard /> : null}
{noTraineeCard ? (
  findTraineeShown ? (
    <ComponentsOffCard
      title="No trainees yet"
      message="Request access to a trainee with Find trainee in the top bar."
      settingsLink={false}
    />
  ) : (
    <ComponentsOffCard
      title="No trainees yet"
      message="Request access to a trainee after switching Find trainee on in"
    />
  )
) : null}
{listRenders ? (
  <CollapsibleTile
    storageKey={listKey}
    startsOpen={listStartsOpen}
    title="Measurements"
    note="Measurements reported by the chosen trainee"
    tileId="measurements"
    stage={listTile.stage}
  >
    {trainerMeasurementsLoaded ? (
      <MeasurementBrowser
        entries={entries}
        readOnly={true}
        visualizeEnabled={chartsTile.shown}
        accountUserId={accountUserId}
        subjectTraineeId={selectedLink.traineeId}
        idPrefix={idPrefix}
        today={today}
        dates={dates}
        page={page}
        pageCount={pageCount}
        pageSize={pageSize}
        month={month}
        client:load
      />
    ) : null}
  </CollapsibleTile>
) : null}
{chartsRender ? (
  <ChartsTile
    accountUserId={accountUserId}
    subjectTraineeId={selectedLink.traineeId}
    readOnly={true}
    month={month}
    today={today}
    startsOpen={chartsStartOpen}
    initialPeriod={chartsPeriod}
    initialAnchor={chartsAnchor}
    initialChart={chartInitial}
    initialDays={chartDays}
    entries={chartEntries}
    stage={chartsTile.stage}
  />
) : null}
{topChartsRender ? (
  <TopChangesTile
    accountUserId={accountUserId}
    subjectTraineeId={selectedLink.traineeId}
    readOnly={true}
    month={month}
    today={today}
    startsOpen={topChartsStartOpen}
    initialPeriod={topChartsPeriod}
    initialAnchor={topChartsAnchor}
    initialChart={topChartInitial}
    initialDays={chartDays}
    initialFields={topChartsFields}
    version={topChartsTile.version}
    initialGainFields={topChartsTile.version === "0.9" ? topChartsGainFields : undefined}
    initialLossFields={topChartsTile.version === "0.9" ? topChartsLossFields : undefined}
    entries={chartEntries}
    stage={topChartsTile.stage}
  />
) : null}
