---
import { Check, ChevronLeft, ChevronRight, X } from "lucide-react";
import CollaborationRowActions from "@/components/hub/CollaborationRowActions";
import ConfirmRemoveToast from "@/components/hub/ConfirmRemoveToast";
import { Button, buttonVariants } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import type { Collaboration, CollaborationPage } from "@/types";

interface Props {
  viewerRole: "trainer" | "trainee";
  page: CollaborationPage;
  confirm?: string | null;
}

const { viewerRole, page, confirm = null } = Astro.props;

const textActionClassName = "text-primary focus-visible:ring-ring underline focus-visible:ring-2";

function pageHref(target: number): string {
  return `/hub/collaborations?page=${target}`;
}

function confirmHref(row: Collaboration): string {
  return `${pageHref(page.page)}&confirm=${encodeURIComponent(row.otherId)}`;
}

// The toast only opens for a linked row on this page; any other `confirm` value is ignored.
const confirming =
  confirm === null ? null : (page.rows.find((row) => row.otherId === confirm && row.status === "linked") ?? null);
---

<div class="flex flex-col gap-4">
  {page.rows.length === 0 ? (
    viewerRole === "trainer" ? (
      <p class="text-muted-foreground text-sm">
        No trainees yet. Find a trainee by email on{" "}
        <a href="/measurements" class:list={[textActionClassName]}>
          Measurements
        </a>
        .
      </p>
    ) : (
      <p class="text-muted-foreground text-sm">No trainers yet.</p>
    )
  ) : (
    <>
      <div class="@container border-border bg-background w-full max-w-full min-w-0 overflow-hidden rounded-md border">
        <Table containerClassName="overflow-x-clip">
          <TableHeader>
            <TableRow className="bg-muted hover:bg-muted">
              <TableHead className="px-3">{viewerRole === "trainer" ? "Trainee" : "Trainer"}</TableHead>
              <TableHead className="px-2 text-center">Status</TableHead>
              <TableHead className="px-3 text-right">
                <span class="sr-only">Actions</span>
              </TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {page.rows.map((row) => (
              <TableRow>
                <TableCell className="px-3 py-2 whitespace-normal">
                  {/* Room for the name plus an email wrapped onto two lines, so every row keeps one height. */}
                  <div class="flex min-h-15 flex-col justify-center">
                    <p class="text-foreground font-semibold break-words">{row.name}</p>
                    {row.email !== row.name ? <p class="text-muted-foreground break-all">{row.email}</p> : null}
                  </div>
                </TableCell>
                <TableCell className="text-muted-foreground px-2 py-2 text-center">
                  {row.status === "pending" ? "Pending" : "Linked"}
                </TableCell>
                <TableCell className="px-1 py-2 @lg:px-3">
                  <div class="flex justify-end @lg:hidden">
                    <CollaborationRowActions
                      viewerRole={viewerRole}
                      otherId={row.otherId}
                      name={row.name}
                      status={row.status}
                      page={page.page}
                      confirmHref={confirmHref(row)}
                      client:load
                    />
                  </div>
                  <div class="hidden justify-end @lg:flex">
                    {viewerRole === "trainer" ? (
                      row.status === "pending" ? (
                        <form method="POST" action="/api/collaborations/remove">
                          <input type="hidden" name="other" value={row.otherId} />
                          <input type="hidden" name="page" value={page.page} />
                          <input type="hidden" name="intent" value="cancel" />
                          <Button type="submit" variant="outline" size="sm">
                            Cancel request
                          </Button>
                        </form>
                      ) : (
                        <a href={confirmHref(row)} class:list={[buttonVariants({ variant: "outline", size: "sm" })]}>
                          Unlink
                        </a>
                      )
                    ) : row.status === "pending" ? (
                      <div class="flex gap-2">
                        <form method="POST" action="/api/collaborations/accept">
                          <input type="hidden" name="other" value={row.otherId} />
                          <input type="hidden" name="page" value={page.page} />
                          <Button type="submit" size="icon" aria-label={`Accept request from ${row.name}`}>
                            <Check aria-hidden="true" />
                          </Button>
                        </form>
                        <form method="POST" action="/api/collaborations/remove">
                          <input type="hidden" name="other" value={row.otherId} />
                          <input type="hidden" name="page" value={page.page} />
                          <input type="hidden" name="intent" value="decline" />
                          <Button
                            type="submit"
                            variant="outline"
                            size="icon"
                            aria-label={`Decline request from ${row.name}`}
                          >
                            <X aria-hidden="true" />
                          </Button>
                        </form>
                      </div>
                    ) : (
                      <a href={confirmHref(row)} class:list={[buttonVariants({ variant: "outline", size: "sm" })]}>
                        Remove
                      </a>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
    </>
  )}
  {page.pageCount > 1 ? (
    <div class="flex flex-wrap items-center justify-end gap-2 text-sm">
      {page.page > 1 ? (
        <a
          href={pageHref(page.page - 1)}
          class:list={[buttonVariants({ variant: "outline", size: "icon" })]}
          aria-label="Previous page"
        >
          <ChevronLeft aria-hidden="true" />
        </a>
      ) : (
        <Button type="button" variant="outline" size="icon" aria-label="Previous page" disabled>
          <ChevronLeft aria-hidden="true" />
        </Button>
      )}
      <p>
        Page {page.page} of {page.pageCount}
      </p>
      {page.page < page.pageCount ? (
        <a
          href={pageHref(page.page + 1)}
          class:list={[buttonVariants({ variant: "outline", size: "icon" })]}
          aria-label="Next page"
        >
          <ChevronRight aria-hidden="true" />
        </a>
      ) : (
        <Button type="button" variant="outline" size="icon" aria-label="Next page" disabled>
          <ChevronRight aria-hidden="true" />
        </Button>
      )}
    </div>
  ) : null}
  {confirming !== null ? (
    <ConfirmRemoveToast
      viewerRole={viewerRole}
      otherId={confirming.otherId}
      name={confirming.name}
      page={page.page}
      client:load
    />
  ) : null}
</div>
