---
import { ChevronLeft, ChevronRight, Dumbbell, PersonStanding } from "lucide-react";
import AccessCell from "@/components/hub/AccessCell";
import CollaborationRowActions from "@/components/hub/CollaborationRowActions";
import ConfirmRevokeToast from "@/components/hub/ConfirmRevokeToast";
import { Button, buttonVariants } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { enabledDashboards, hasGrantedAccess, type DashboardConfig } from "@/lib/dashboards";
import { cn } from "@/lib/utils";
import type { Collaboration, CollaborationPage, Dashboard } from "@/types";

interface Props {
  viewerRole: "trainer" | "trainee";
  page: CollaborationPage;
  confirm?: string | null;
  /** The Access sub-columns; the kitchen sink passes every dashboard, the app only the enabled ones. */
  dashboards?: readonly DashboardConfig[];
}

const { viewerRole, page, confirm = null, dashboards = enabledDashboards() } = Astro.props;

const textActionClassName = "text-primary focus-visible:ring-ring underline focus-visible:ring-2";

function pageHref(target: number): string {
  return `/hub/collaborations?page=${target}`;
}

function confirmHref(row: Collaboration, dashboard: Dashboard): string {
  return `${pageHref(page.page)}&confirm=${encodeURIComponent(row.otherId)}&dashboard=${dashboard}`;
}

const PartyIcon = viewerRole === "trainer" ? PersonStanding : Dumbbell;

const stickyHeaderClassName = "sticky left-0 z-10 bg-muted";
const stickyBodyClassName = "sticky left-0 z-10 bg-background group-hover:bg-muted/50";

// The toast only opens for a row on this page with granted measurements access; any other `confirm` value is ignored.
const confirming =
  confirm === null
    ? null
    : (page.rows.find((row) => row.otherId === confirm && hasGrantedAccess(row, "measurements")) ?? null);
---

<div class="flex flex-col gap-4">
  {page.rows.length === 0 ? (
    viewerRole === "trainer" ? (
      <p class="text-muted-foreground text-sm">
        No trainees yet. Find a trainee by email on{" "}
        <a href="/measurements" class:list={[textActionClassName]}>
          Measurements
        </a>
        .
      </p>
    ) : (
      <p class="text-muted-foreground text-sm">No trainers yet.</p>
    )
  ) : (
    <div
      data-collaborations-table
      style={`--dashboard-count: ${dashboards.length}`}
      class="@container border-border bg-background w-full max-w-full min-w-0 overflow-hidden rounded-md border"
    >
      {/* Fixed layout: the Access columns keep their width, so a long unbroken email cannot push them out. The party
          column stays put while further Access columns scroll, as on the measurement rows; widths in global.css. */}
      <Table className="table-fixed">
        {/* A fixed table sizes its columns from the first row, where Access spans every dashboard, so set them here. */}
        <colgroup>
          <col class="@lg:w-64" />
          {dashboards.map(() => (
            <col class="w-28" />
          ))}
        </colgroup>
        <TableHeader>
          <TableRow className="bg-muted hover:bg-muted">
            <TableHead rowSpan={2} className={cn("h-auto px-2 py-2 @lg:px-3", stickyHeaderClassName)}>
              <span class="inline-flex flex-col items-center gap-1">
                <PartyIcon aria-hidden="true" className="size-4" />
                <span>{viewerRole === "trainer" ? "Trainee" : "Trainer"}</span>
              </span>
            </TableHead>
            <TableHead colSpan={dashboards.length} className="h-auto px-2 pt-2 pb-1 text-center">
              Access
            </TableHead>
          </TableRow>
          <TableRow className="bg-muted hover:bg-muted">
            {dashboards.map((dashboard) => (
              <TableHead className="h-auto truncate px-1 pt-1 pb-2 text-center">{dashboard.label}</TableHead>
            ))}
          </TableRow>
        </TableHeader>
        <TableBody>
          {page.rows.map((row) => (
            <TableRow className="group">
              <TableCell className={cn("px-2 py-2 @lg:px-3", stickyBodyClassName)}>
                {/* One line each for the name and the email, cut with an ellipsis; the title carries the full text. */}
                <div class="flex min-h-10 flex-col justify-center">
                  <p class="text-foreground truncate font-semibold" title={row.name}>
                    {row.name}
                  </p>
                  {row.email !== row.name ? (
                    <p class="text-muted-foreground truncate" title={row.email}>
                      {row.email}
                    </p>
                  ) : null}
                </div>
              </TableCell>
              {dashboards.map((dashboard) => {
                const entries = row.access[dashboard.id];
                return (
                  <TableCell className="px-1 py-2">
                    <div class="flex items-center gap-1">
                      <div class="flex min-w-0 flex-1 items-center">
                        <AccessCell dashboardLabel={dashboard.label} name={row.name} entries={entries} client:load />
                      </div>
                      {entries.length > 0 ? (
                        <div class="flex shrink-0 justify-end">
                          <CollaborationRowActions
                            viewerRole={viewerRole}
                            otherId={row.otherId}
                            name={row.name}
                            dashboard={dashboard.id}
                            dashboardLabel={dashboard.label}
                            entries={entries}
                            page={page.page}
                            confirmHref={confirmHref(row, dashboard.id)}
                            client:load
                          />
                        </div>
                      ) : null}
                    </div>
                  </TableCell>
                );
              })}
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  )}
  {page.pageCount > 1 ? (
    <div class="flex flex-wrap items-center justify-end gap-2 text-sm">
      {page.page > 1 ? (
        <a
          href={pageHref(page.page - 1)}
          class:list={[buttonVariants({ variant: "outline", size: "icon" })]}
          aria-label="Previous page"
        >
          <ChevronLeft aria-hidden="true" />
        </a>
      ) : (
        <Button type="button" variant="outline" size="icon" aria-label="Previous page" disabled>
          <ChevronLeft aria-hidden="true" />
        </Button>
      )}
      <p>
        Page {page.page} of {page.pageCount}
      </p>
      {page.page < page.pageCount ? (
        <a
          href={pageHref(page.page + 1)}
          class:list={[buttonVariants({ variant: "outline", size: "icon" })]}
          aria-label="Next page"
        >
          <ChevronRight aria-hidden="true" />
        </a>
      ) : (
        <Button type="button" variant="outline" size="icon" aria-label="Next page" disabled>
          <ChevronRight aria-hidden="true" />
        </Button>
      )}
    </div>
  ) : null}
  {confirming !== null ? (
    <ConfirmRevokeToast
      viewerRole={viewerRole}
      otherId={confirming.otherId}
      name={confirming.name}
      dashboard="measurements"
      page={page.page}
      client:load
    />
  ) : null}
</div>
