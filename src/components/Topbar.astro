---
import TopbarActions from "@/components/TopbarActions";
import { readProfileRole } from "@/lib/services/ensure-profile";
import { readProfileNames } from "@/lib/services/profile-details";
import { createClient } from "@/lib/supabase";
import { topbarModel, type TopbarModelInput } from "@/lib/topbar";

interface Props {
  preview?: TopbarModelInput;
}

const { preview } = Astro.props;

let model;
if (preview) {
  model = topbarModel(preview);
} else {
  const user = Astro.locals.user;
  const signedIn = Boolean(user);
  const email = user?.email ?? "";
  const pathname = Astro.url.pathname;
  let role: TopbarModelInput["role"] = null;
  let firstName: string | null = null;
  let lastName: string | null = null;

  if (user) {
    const supabase = createClient(Astro.request.headers, Astro.cookies);
    if (supabase) {
      const [readRole, names] = await Promise.all([
        readProfileRole(supabase, user.id),
        readProfileNames(supabase, user.id),
      ]);
      role = readRole;
      firstName = names?.firstName ?? null;
      lastName = names?.lastName ?? null;
    }
  }

  model = topbarModel({ signedIn, email, role, firstName, lastName, pathname });
}
---

<div class="border-border bg-card text-muted-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm">
  <TopbarActions
    client:load
    greeting={model.greeting}
    email={model.email}
    links={model.links}
    account={model.account}
  />
</div>
