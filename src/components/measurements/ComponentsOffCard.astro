---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

// The one card `/measurements` renders when every Measurements component of the role is off. The default slot sits
// above the message (the trainer's picker).
---

<div class="flex justify-center px-4 pb-4">
  <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4" data-components-off>
    <slot />
    <h1 class="text-xl font-bold text-foreground">Every Measurements component is off</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Switch them on in
      <a href="/settings/components" class:list={[cn(buttonVariants({ variant: "link" }), "h-auto p-0")]}>
        Settings → Components
      </a>
    </p>
  </div>
</div>
