---
import VersionBadge from "@/components/measurements/VersionBadge";
import { PREFERENCE_COOKIE_MAX_AGE } from "@/lib/preference-cookies";
import type { VersionStage } from "@/types";

interface Props {
  /** Where the open state is remembered (localStorage and cookie); `null` keeps it for this visit only. */
  storageKey: string | null;
  startsOpen: boolean;
  title: string;
  /** The muted line under the title; `null` renders it hidden for the island to fill, absent renders none. */
  note?: string | null;
  /** Written to `data-tile`, so each island finds only its own tile's title and note. */
  tileId: string;
  /**
   * `false` keeps the server's open state for this load: the stored choice is not restored, and the first toggle the
   * browser fires for an initially open tile is not saved over it (the add form after a server error).
   */
  restore?: boolean;
  /**
   * The tile's chosen version's stage: a preview puts a red "Preview" badge in the header, left of the chevron, and a
   * release candidate a yellow "RC" one. Stable (or `null`) shows none.
   */
  stage?: VersionStage | null;
}

const { storageKey, startsOpen, title, note, tileId, restore = true, stage = "stable" } = Astro.props;
const badgeStage = stage === "preview" || stage === "rc" ? stage : null;
const badged = badgeStage !== null;

const headingId = `${tileId}-${crypto.randomUUID()}`;
const hasNote = note !== undefined;
---

<div class="flex justify-center px-4 pb-4">
  <div
    class="border-border bg-card relative w-full max-w-measurement min-w-0 rounded-xl border p-4"
    data-tile-card={tileId}
  >
    <details
      class="group"
      aria-labelledby={`${headingId}-title`}
      data-tile={tileId}
      data-storage-key={storageKey}
      data-cookie-max-age={PREFERENCE_COOKIE_MAX_AGE}
      data-restore={restore ? "true" : undefined}
      open={startsOpen}
    >
      <summary
        aria-labelledby={`${headingId}-title`}
        aria-describedby={hasNote ? `${headingId}-note` : undefined}
        class:list={[
          "flex cursor-pointer list-none justify-between gap-2 rounded-md text-xl font-bold text-foreground select-none focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none [&::-webkit-details-marker]:hidden",
          // With the badge, the chevron sits on the title line so the badge can line up beside it.
          badged ? "items-start" : "items-center",
        ]}
      >
        {/* The title column leaves room for the badge, so the chevron itself stays at the edge. */}
        <span class:list={["flex min-w-0 flex-col", badged && "pr-20"]}>
          <span id={`${headingId}-title`} data-tile-title>
            {title}
          </span>
          {hasNote ? (
            <span
              id={`${headingId}-note`}
              data-tile-note
              class="text-sm font-normal text-muted-foreground"
              hidden={note === null}
            >
              {note}
            </span>
          ) : null}
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class:list={["size-5 shrink-0 transition-transform group-open:rotate-180", badged && "mt-1"]}
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <div class="pt-3">
        <slot />
      </div>
    </details>
    <script is:inline>
      (function () {
        var script = document.currentScript;
        var details = script && script.previousElementSibling;
        if (!(details instanceof HTMLDetailsElement)) return;
        var key = details.getAttribute("data-storage-key");
        if (!key) return;
        var restore = details.getAttribute("data-restore") === "true";
        // Without a lifetime the cookie is a session cookie: it still covers this visit.
        var maxAge = details.getAttribute("data-cookie-max-age");
        var lifetime = maxAge ? "; Max-Age=" + maxAge : "";
        function remember(value) {
          try {
            localStorage.setItem(key, value);
          } catch (error) {
            // Storage can be blocked; the cookie still keeps the next visit.
          }
          try {
            document.cookie =
              encodeURIComponent(key) + "=" + encodeURIComponent(value) + "; Path=/" + lifetime + "; SameSite=Lax";
          } catch (error) {
            // The choice still stays for this visit.
          }
        }
        var skipLoadToggle = !restore && details.open;
        details.addEventListener("toggle", function () {
          if (skipLoadToggle) {
            skipLoadToggle = false;
            return;
          }
          remember(details.open ? "open" : "closed");
        });
        if (!restore) return;
        var stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch (error) {
          stored = null;
        }
        if (stored === "open" || stored === "closed") {
          details.open = stored === "open";
          remember(stored);
        }
      })();
    </script>
    {/* Outside <details> (and after the script, which finds it as its previous sibling): never interactive content
         inside <summary>, and still visible when the tile is closed. */}
    {badgeStage !== null ? (
      <div class="absolute top-4.5 right-12">
        <VersionBadge stage={badgeStage} client:load />
      </div>
    ) : null}
  </div>
</div>
