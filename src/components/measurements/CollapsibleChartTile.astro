---
interface Props {
  /** Where the open state is remembered (localStorage and cookie); `null` keeps it for this visit only. */
  storageKey: string | null;
  startsOpen: boolean;
  title: string;
  /** The muted line under the title; `null` renders it hidden for the island to fill. */
  note: string | null;
  /** Written to `data-chart-tile`, so each island finds only its own tile's title and note. */
  tileId: string;
}

const { storageKey, startsOpen, title, note, tileId } = Astro.props;

const headingId = `${tileId}-${crypto.randomUUID()}`;
---

<div class="flex justify-center px-4 pb-4">
  <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
    <details
      class="group"
      aria-labelledby={`${headingId}-title`}
      data-charts-tile
      data-chart-tile={tileId}
      data-storage-key={storageKey}
      open={startsOpen}
    >
      <summary
        aria-labelledby={`${headingId}-title`}
        aria-describedby={`${headingId}-note`}
        class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md text-xl font-bold text-foreground select-none focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none [&::-webkit-details-marker]:hidden"
      >
        <span class="flex min-w-0 flex-col">
          <span id={`${headingId}-title`} data-charts-title>
            {title}
          </span>
          <span
            id={`${headingId}-note`}
            data-charts-note
            class="text-sm font-normal text-muted-foreground"
            hidden={note === null}
          >
            {note}
          </span>
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5 shrink-0 transition-transform group-open:rotate-180"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <div class="pt-3">
        <slot />
      </div>
    </details>
    <script is:inline>
      (function () {
        var script = document.currentScript;
        var details = script && script.previousElementSibling;
        if (!(details instanceof HTMLDetailsElement)) return;
        var key = details.getAttribute("data-storage-key");
        if (!key) return;
        function remember(value) {
          try {
            localStorage.setItem(key, value);
          } catch (error) {
            // Storage can be blocked; the cookie still keeps the next visit.
          }
          try {
            document.cookie =
              encodeURIComponent(key) + "=" + encodeURIComponent(value) + "; Path=/; Max-Age=31536000; SameSite=Lax";
          } catch (error) {
            // The choice still stays for this visit.
          }
        }
        details.addEventListener("toggle", function () {
          remember(details.open ? "open" : "closed");
        });
        var stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch (error) {
          stored = null;
        }
        if (stored === "open" || stored === "closed") {
          details.open = stored === "open";
          remember(stored);
        }
      })();
    </script>
  </div>
</div>
