---
import CollapsibleTile from "@/components/measurements/CollapsibleTile.astro";
import TopChangesCharts, { topChangesHeading, topChangesTileId } from "@/components/measurements/TopChangesCharts";
import TopChangesChartsRc from "@/components/measurements/TopChangesChartsRc";
import type { ChartBody } from "@/types";
import { defaultChartPeriod, type ChartPeriod } from "@/lib/measurement-chart";
import { topChartsOpenStorageKey } from "@/lib/measurement-page";
import { circumferenceFields } from "@/lib/measurement-top-changes";
import type { CircumferenceField, MeasurementWithDeltas } from "@/types";

interface Props {
  accountUserId?: string;
  subjectTraineeId?: string;
  readOnly: boolean;
  month?: string;
  today?: string;
  startsOpen: boolean;
  /** Kitchen-sink local mode: chart these entries without a fetch. */
  entries?: MeasurementWithDeltas[];
  /** Kitchen-sink only: hold the loading state. */
  forceLoading?: boolean;
  /** The period from the preference cookie, so the charts are right on the first render. */
  initialPeriod?: ChartPeriod;
  /** The remembered week, month or year; `null` starts from the list's month. */
  initialAnchor?: string | null;
  /** The server's chart read for `initialPeriod`; `null` leaves the read to the island. */
  initialChart?: ChartBody | null;
  initialDays?: string[] | null;
  /** The chosen version is a preview: the tile carries the Preview badge. */
  preview?: boolean;
  /** 0.1: the shared circumference filter. The circumferences from the preference cookie; all 7 when absent. */
  initialFields?: readonly CircumferenceField[];
  /** Which island the tile shows: 0.1, or the 0.9 release candidate. */
  version?: "0.1" | "0.9";
  /** 0.9: the circumference gain chart's fields from the preference cookie; all 7 when absent. */
  initialGainFields?: readonly CircumferenceField[];
  /** 0.9: the circumference loss chart's fields from the preference cookie; all 7 when absent. */
  initialLossFields?: readonly CircumferenceField[];
}

const {
  accountUserId,
  subjectTraineeId,
  readOnly,
  month,
  today,
  startsOpen,
  entries,
  forceLoading = false,
  initialPeriod = defaultChartPeriod,
  initialAnchor = null,
  initialChart = null,
  initialDays = null,
  preview = false,
  initialFields = circumferenceFields,
  version = "0.1",
  initialGainFields = circumferenceFields,
  initialLossFields = circumferenceFields,
} = Astro.props;

const storageKey = accountUserId ? topChartsOpenStorageKey(accountUserId) : null;
---

<CollapsibleTile
  storageKey={storageKey}
  startsOpen={startsOpen}
  title={topChangesHeading.title}
  note={topChangesHeading.note}
  preview={preview}
  tileId={topChangesTileId}
>
  {version === "0.9" ? (
    <TopChangesChartsRc
      accountUserId={accountUserId}
      subjectTraineeId={subjectTraineeId}
      readOnly={readOnly}
      month={month}
      today={today}
      entries={entries}
      forceLoading={forceLoading}
      initialPeriod={initialPeriod}
      initialAnchor={initialAnchor}
      initialChart={initialChart}
      initialDays={initialDays}
      initialGainFields={initialGainFields}
      initialLossFields={initialLossFields}
      client:load
    />
  ) : (
    <TopChangesCharts
      accountUserId={accountUserId}
      subjectTraineeId={subjectTraineeId}
      readOnly={readOnly}
      month={month}
      today={today}
      entries={entries}
      forceLoading={forceLoading}
      initialPeriod={initialPeriod}
      initialAnchor={initialAnchor}
      initialChart={initialChart}
      initialDays={initialDays}
      initialFields={initialFields}
      client:load
    />
  )}
</CollapsibleTile>
