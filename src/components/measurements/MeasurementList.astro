---
import { Button } from "@/components/ui/button";
import { measurementFields, toMeasuredOnLocalValue } from "@/lib/measurement-input";
import { formatDelta } from "@/lib/measurement-deltas";
import type { FieldDelta, MeasurementWithDeltas } from "@/types";

interface Props {
  entries: MeasurementWithDeltas[];
  editHref?: (entry: MeasurementWithDeltas) => string;
  deleteHref?: (entry: MeasurementWithDeltas) => string;
  confirmingId?: string;
  preserveEditId?: string;
}

const { entries, editHref, deleteHref, confirmingId, preserveEditId } = Astro.props;

const cancelHref = preserveEditId ? `/measurements?edit=${encodeURIComponent(preserveEditId)}` : "/measurements";

function formatMeasurement(value: number): string {
  return value.toFixed(1);
}

function measuredOnDisplay(value: string): { text: string; dateTime: string } {
  const local = toMeasuredOnLocalValue(value);
  return { text: local.replace("T", " "), dateTime: `${local}:00` };
}

function accessibleValue(label: string, value: number, unit: string): string {
  return `${label} ${formatMeasurement(value)} ${unit}`;
}

function accessibleDelta(label: string, unit: string, delta: FieldDelta): string {
  const direction = delta.direction === "none" ? "unchanged" : delta.direction;
  return `${label} ${direction} ${delta.difference.toFixed(1)} ${unit}`;
}
---

<ul class="mt-6 space-y-4 text-left">
  {entries.map((entry) => (
    <li class="rounded-lg border border-border bg-muted p-4 text-sm text-card-foreground">
      <div class="flex flex-nowrap items-start gap-2">
        <div class="w-56 max-w-56 min-w-56 shrink-0">
          <div class="mb-1 text-muted-foreground">Date and time</div>
          <time datetime={measuredOnDisplay(entry.measured_on).dateTime} class="font-semibold text-card-foreground">
            {measuredOnDisplay(entry.measured_on).text}
          </time>
          {editHref ? (
            <a
              href={editHref(entry)}
              aria-label={`Edit measurement from ${measuredOnDisplay(entry.measured_on).text}`}
              class="mt-1 block w-fit whitespace-nowrap text-primary hover:underline focus-visible:ring-2 focus-visible:ring-ring"
            >
              Edit
            </a>
          ) : null}
          {deleteHref && entry.id !== confirmingId ? (
            <a
              href={deleteHref(entry)}
              aria-label={`Delete measurement from ${measuredOnDisplay(entry.measured_on).text}`}
              class="mt-1 block w-fit whitespace-nowrap text-primary hover:underline focus-visible:ring-2 focus-visible:ring-ring"
            >
              Delete
            </a>
          ) : null}
        </div>
        {measurementFields.map((field) => (
          <div class="w-28 max-w-28 min-w-28 shrink-0">
            <div class="mb-1 text-muted-foreground">
              {field.label} {field.unit}
            </div>
            <div
              class="border-input flex h-9 items-center rounded-md border px-3 whitespace-nowrap"
              aria-label={accessibleValue(field.label, entry[field.field], field.unit)}
              set:text={formatMeasurement(entry[field.field])}
            />
            {entry.deltas ? (
              <p
                class="mt-1 text-base font-semibold text-card-foreground"
                aria-label={accessibleDelta(field.label, field.unit, entry.deltas[field.field])}
                set:text={formatDelta(entry.deltas[field.field])}
              />
            ) : null}
          </div>
        ))}
      </div>
      {deleteHref && entry.id === confirmingId ? (
        <form
          method="POST"
          action={`/api/measurements/${encodeURIComponent(entry.id)}/delete`}
          class="mt-3 flex w-0 min-w-full flex-wrap items-center gap-4"
        >
          <p>Delete measurement from {measuredOnDisplay(entry.measured_on).text}?</p>
          {preserveEditId ? <input type="hidden" name="edit" value={preserveEditId} /> : null}
          <Button type="submit">Delete</Button>
          <a href={cancelHref} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-ring">
            Cancel
          </a>
        </form>
      ) : null}
      {entry.note ? (
        <p class="mt-3 w-0 min-w-full wrap-break-word whitespace-pre-wrap text-muted-foreground">{entry.note}</p>
      ) : null}
    </li>
  ))}
</ul>
