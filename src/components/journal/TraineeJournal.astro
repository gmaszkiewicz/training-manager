---
import ChartsTile from "@/components/measurements/ChartsTile.astro";
import TopChangesTile from "@/components/measurements/TopChangesTile.astro";
import type { ChartBody } from "@/components/measurements/MeasurementCharts";
import type { ChartPeriod } from "@/lib/measurement-chart";
import MeasurementBrowser from "@/components/measurements/MeasurementBrowser";
import MeasurementForm from "@/components/measurements/MeasurementForm";
import PageErrorToasts from "@/components/measurements/PageErrorToasts";
import { addFormStartsOpen, addFormStorageKey, type PageSize } from "@/lib/measurement-page";
import type { CircumferenceField, MeasurementEntry, MeasurementField, MeasurementWithDeltas } from "@/types";

interface Props {
  measurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  serverError: string | null;
  notice?: string | null;
  editingEntry?: MeasurementEntry | null;
  confirmingEntry?: MeasurementEntry | null;
  /** The trainee's latest entry; the add form starts from its values. */
  previousEntry?: Pick<MeasurementEntry, MeasurementField> | null;
  idPrefix?: string;
  accountUserId?: string;
  subjectTraineeId?: string;
  today?: string;
  dates?: string[];
  page?: number;
  pageCount?: number;
  pageSize?: PageSize;
  month?: string;
  addFormOpen?: boolean | null;
  chartsOpen?: boolean | null;
  chartsPeriod?: ChartPeriod;
  chartsAnchor?: string | null;
  /** The server's chart read and entry days for the tile's first render. */
  chartInitial?: ChartBody | null;
  chartDays?: string[] | null;
  topChartsOpen?: boolean | null;
  topChartsPeriod?: ChartPeriod;
  topChartsAnchor?: string | null;
  /** The server's Top changes read for the tile's first render; its picker shares `chartDays`. */
  topChartInitial?: ChartBody | null;
  /** The circumferences from the preference cookie; all 7 when absent. */
  topChartsFields?: readonly CircumferenceField[];
}

const {
  measurementsLoaded,
  entries,
  serverError,
  notice = null,
  editingEntry = null,
  confirmingEntry = null,
  previousEntry = null,
  idPrefix = "",
  accountUserId,
  subjectTraineeId,
  today,
  dates,
  page,
  pageCount,
  pageSize,
  month,
  addFormOpen = null,
  chartsOpen = null,
  chartsPeriod,
  chartsAnchor = null,
  chartInitial = null,
  chartDays = null,
  topChartsOpen = null,
  topChartsPeriod,
  topChartsAnchor = null,
  topChartInitial = null,
  topChartsFields,
} = Astro.props;

const formStartsOpen = addFormStartsOpen(serverError !== null, addFormOpen);
const addFormKey = accountUserId ? addFormStorageKey(accountUserId) : null;
const chartsStartOpen = addFormStartsOpen(false, chartsOpen);
const topChartsStartOpen = addFormStartsOpen(false, topChartsOpen);
---

<div class="flex justify-center px-4 pb-4">
  <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
    {measurementsLoaded ? (
      <>
        {notice ? (
          <PageErrorToasts messages={[notice]} tone="notice" clearParams={["notice", "measured_on"]} client:load />
        ) : null}
        {editingEntry ? (
          <>
            <h1 class="mb-3 text-xl font-bold text-foreground">Edit measurement</h1>
            <MeasurementForm serverError={serverError} idPrefix={idPrefix} entry={editingEntry} client:load />
          </>
        ) : (
          <>
            <details
              class="group"
              data-add-form
              data-storage-key={addFormKey}
              data-restore={serverError === null ? "true" : undefined}
              open={formStartsOpen}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md text-xl font-bold text-foreground select-none focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none [&::-webkit-details-marker]:hidden">
                <span>Add your next measurement</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5 shrink-0 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="pt-3">
                <MeasurementForm
                  serverError={serverError}
                  idPrefix={idPrefix}
                  previousEntry={previousEntry}
                  client:load
                />
              </div>
            </details>
            <script is:inline>
              (function () {
                var script = document.currentScript;
                var details = script && script.previousElementSibling;
                if (!(details instanceof HTMLDetailsElement)) return;
                var key = details.getAttribute("data-storage-key");
                if (!key) return;
                function remember(value) {
                  try {
                    localStorage.setItem(key, value);
                  } catch (error) {
                    // Storage can be blocked; the cookie still keeps the next visit.
                  }
                  try {
                    document.cookie =
                      encodeURIComponent(key) +
                      "=" +
                      encodeURIComponent(value) +
                      "; Path=/; Max-Age=31536000; SameSite=Lax";
                  } catch (error) {
                    // The choice still stays for this visit.
                  }
                }
                var skipLoadToggle = details.getAttribute("data-restore") !== "true" && details.open;
                details.addEventListener("toggle", function () {
                  if (skipLoadToggle) {
                    skipLoadToggle = false;
                    return;
                  }
                  remember(details.open ? "open" : "closed");
                });
                if (details.getAttribute("data-restore") === "true") {
                  var stored = null;
                  try {
                    stored = localStorage.getItem(key);
                  } catch (error) {
                    stored = null;
                  }
                  if (stored === "open" || stored === "closed") {
                    details.open = stored === "open";
                    remember(stored);
                  }
                }
              })();
            </script>
          </>
        )}
        <MeasurementBrowser
          entries={entries}
          readOnly={false}
          editingId={editingEntry?.id}
          confirmingId={confirmingEntry?.id}
          accountUserId={accountUserId}
          subjectTraineeId={subjectTraineeId}
          idPrefix={idPrefix}
          today={today}
          dates={dates}
          page={page}
          pageCount={pageCount}
          pageSize={pageSize}
          month={month}
          client:load
        />
      </>
    ) : (
      <>
        <h1 class="mb-3 text-xl font-bold text-foreground">Add your next measurement</h1>
        <PageErrorToasts messages={["Could not load your measurements"]} client:load />
      </>
    )}
  </div>
</div>
{measurementsLoaded && !editingEntry && accountUserId && subjectTraineeId ? (
  <ChartsTile
    accountUserId={accountUserId}
    subjectTraineeId={subjectTraineeId}
    readOnly={false}
    month={month}
    today={today}
    startsOpen={chartsStartOpen}
    initialPeriod={chartsPeriod}
    initialAnchor={chartsAnchor}
    initialChart={chartInitial}
    initialDays={chartDays}
  />
) : null}
{measurementsLoaded && !editingEntry && accountUserId && subjectTraineeId ? (
  <TopChangesTile
    accountUserId={accountUserId}
    subjectTraineeId={subjectTraineeId}
    readOnly={false}
    month={month}
    today={today}
    startsOpen={topChartsStartOpen}
    initialPeriod={topChartsPeriod}
    initialAnchor={topChartsAnchor}
    initialChart={topChartInitial}
    initialDays={chartDays}
    initialFields={topChartsFields}
  />
) : null}
