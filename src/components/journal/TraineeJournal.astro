---
import ChartsTile from "@/components/measurements/ChartsTile.astro";
import CollapsibleTile from "@/components/measurements/CollapsibleTile.astro";
import ComponentsOffCard from "@/components/measurements/ComponentsOffCard.astro";
import TopChangesTile from "@/components/measurements/TopChangesTile.astro";
import type { ChartBody, ComponentTiles } from "@/types";
import type { ChartPeriod } from "@/lib/measurement-chart";
import MeasurementBrowser from "@/components/measurements/MeasurementBrowser";
import MeasurementForm from "@/components/measurements/MeasurementForm";
import PageErrorToasts from "@/components/measurements/PageErrorToasts";
import { tileOf } from "@/lib/components";
import { addFormStartsOpen, addFormStorageKey, listOpenStorageKey, type PageSize } from "@/lib/measurement-page";
import type { CircumferenceField, MeasurementEntry, MeasurementField, MeasurementWithDeltas } from "@/types";

interface Props {
  measurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  serverError: string | null;
  notice?: string | null;
  editingEntry?: MeasurementEntry | null;
  confirmingEntry?: MeasurementEntry | null;
  /** The trainee's latest entry; the add form starts from its values. */
  previousEntry?: Pick<MeasurementEntry, MeasurementField> | null;
  idPrefix?: string;
  accountUserId?: string;
  subjectTraineeId?: string;
  today?: string;
  dates?: string[];
  page?: number;
  pageCount?: number;
  pageSize?: PageSize;
  month?: string;
  addFormOpen?: boolean | null;
  listOpen?: boolean | null;
  chartsOpen?: boolean | null;
  chartsPeriod?: ChartPeriod;
  chartsAnchor?: string | null;
  /** The server's chart read and entry days for the tile's first render. */
  chartInitial?: ChartBody | null;
  chartDays?: string[] | null;
  topChartsOpen?: boolean | null;
  topChartsPeriod?: ChartPeriod;
  topChartsAnchor?: string | null;
  /** The server's Top progression read for the tile's first render; its picker shares `chartDays`. */
  topChartInitial?: ChartBody | null;
  /** The circumferences from the preference cookie; all 7 when absent. */
  topChartsFields?: readonly CircumferenceField[];
  /** Which tiles render and which carry the Preview badge, by the trainee's own settings; every tile when absent. */
  shown?: ComponentTiles;
}

const {
  measurementsLoaded,
  entries,
  serverError,
  notice = null,
  editingEntry = null,
  confirmingEntry = null,
  previousEntry = null,
  idPrefix = "",
  accountUserId,
  subjectTraineeId,
  today,
  dates,
  page,
  pageCount,
  pageSize,
  month,
  addFormOpen = null,
  listOpen = null,
  chartsOpen = null,
  chartsPeriod,
  chartsAnchor = null,
  chartInitial = null,
  chartDays = null,
  topChartsOpen = null,
  topChartsPeriod,
  topChartsAnchor = null,
  topChartInitial = null,
  topChartsFields,
  shown = {},
} = Astro.props;

const formStartsOpen = addFormStartsOpen(serverError !== null, addFormOpen);
const addFormKey = accountUserId ? addFormStorageKey(accountUserId) : null;
const listKey = accountUserId ? listOpenStorageKey(accountUserId) : null;
const listStartsOpen = addFormStartsOpen(false, listOpen);
const chartsStartOpen = addFormStartsOpen(false, chartsOpen);
const topChartsStartOpen = addFormStartsOpen(false, topChartsOpen);
const newTile = tileOf(shown, "new-measurement");
const editTile = tileOf(shown, "edit-measurement");
const listTile = tileOf(shown, "measurements");
const chartsTile = tileOf(shown, "progression");
const topChartsTile = tileOf(shown, "top-changes");
// Edit measurement has no tile of its own: it shows only as the Edit card, so with the rest off nothing renders.
const editing = editingEntry !== null && editTile.shown;
const everyComponentOff = !editing && !newTile.shown && !listTile.shown && !chartsTile.shown && !topChartsTile.shown;
const chartsRender = measurementsLoaded && !editing;
---

{everyComponentOff ? (
  <>
    {notice ? (
      <PageErrorToasts messages={[notice]} tone="notice" clearParams={["notice", "measured_on"]} client:load />
    ) : null}
    <ComponentsOffCard />
  </>
) : measurementsLoaded ? (
  <>
    {notice ? (
      <PageErrorToasts messages={[notice]} tone="notice" clearParams={["notice", "measured_on"]} client:load />
    ) : null}
    {editing ? (
      <div class="flex justify-center px-4 pb-4">
        <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
          <h1 class="mb-3 text-xl font-bold text-foreground">Edit measurement</h1>
          <MeasurementForm serverError={serverError} idPrefix={idPrefix} entry={editingEntry} client:load />
        </div>
      </div>
    ) : newTile.shown ? (
      <CollapsibleTile
        storageKey={addFormKey}
        startsOpen={formStartsOpen}
        title="New measurement"
        note="Report a new measurement"
        tileId="new-measurement"
        restore={serverError === null}
        preview={newTile.preview}
      >
        <MeasurementForm serverError={serverError} idPrefix={idPrefix} previousEntry={previousEntry} client:load />
      </CollapsibleTile>
    ) : null}
    {listTile.shown ? (
      <CollapsibleTile
        storageKey={listKey}
        startsOpen={listStartsOpen}
        title="Your measurements"
        note="Measurements reported so far"
        tileId="measurements"
        preview={listTile.preview}
      >
        <MeasurementBrowser
          entries={entries}
          readOnly={false}
          editEnabled={editTile.shown}
          editingId={editing ? editingEntry.id : undefined}
          confirmingId={confirmingEntry?.id}
          accountUserId={accountUserId}
          subjectTraineeId={subjectTraineeId}
          idPrefix={idPrefix}
          today={today}
          dates={dates}
          page={page}
          pageCount={pageCount}
          pageSize={pageSize}
          month={month}
          client:load
        />
      </CollapsibleTile>
    ) : null}
  </>
) : (
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4">
      <h1 class="mb-3 text-xl font-bold text-foreground">{newTile.shown ? "New measurement" : "Your measurements"}</h1>
      <PageErrorToasts messages={["Could not load your measurements"]} client:load />
    </div>
  </div>
)}
{chartsRender && chartsTile.shown && accountUserId && subjectTraineeId ? (
  <ChartsTile
    accountUserId={accountUserId}
    subjectTraineeId={subjectTraineeId}
    readOnly={false}
    month={month}
    today={today}
    startsOpen={chartsStartOpen}
    initialPeriod={chartsPeriod}
    initialAnchor={chartsAnchor}
    initialChart={chartInitial}
    initialDays={chartDays}
    preview={chartsTile.preview}
  />
) : null}
{chartsRender && topChartsTile.shown && accountUserId && subjectTraineeId ? (
  <TopChangesTile
    accountUserId={accountUserId}
    subjectTraineeId={subjectTraineeId}
    readOnly={false}
    month={month}
    today={today}
    startsOpen={topChartsStartOpen}
    initialPeriod={topChartsPeriod}
    initialAnchor={topChartsAnchor}
    initialChart={topChartInitial}
    initialDays={chartDays}
    initialFields={topChartsFields}
    preview={topChartsTile.preview}
  />
) : null}
