---
import { ServerError } from "@/components/auth/ServerError";
import MeasurementBrowser from "@/components/measurements/MeasurementBrowser";
import MeasurementForm from "@/components/measurements/MeasurementForm";
import type { PageSize } from "@/lib/measurement-page";
import type { MeasurementEntry, MeasurementWithDeltas } from "@/types";

interface Props {
  measurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  serverError: string | null;
  editingEntry?: MeasurementEntry | null;
  confirmingEntry?: MeasurementEntry | null;
  idPrefix?: string;
  accountUserId?: string;
  subjectTraineeId?: string;
  today?: string;
  dates?: string[];
  page?: number;
  pageCount?: number;
  pageSize?: PageSize;
  month?: string;
}

const {
  measurementsLoaded,
  entries,
  serverError,
  editingEntry = null,
  confirmingEntry = null,
  idPrefix = "",
  accountUserId,
  subjectTraineeId,
  today,
  dates,
  page,
  pageCount,
  pageSize,
  month,
} = Astro.props;
---

<div class="flex justify-center px-4 pb-8">
  <!-- date w-36 + 8×w-28 + gaps + list padding + card padding + both borders -->
  <div
    class:list={[
      "rounded-2xl border border-border bg-card p-8 text-card-foreground",
      measurementsLoaded ? "w-max min-w-[calc(75rem+4px)]" : "w-max",
    ]}
  >
    <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">
      {editingEntry ? "Edit measurement" : "Add your next measurement"}
    </h1>
    {measurementsLoaded ? (
      <>
        <MeasurementForm serverError={serverError} idPrefix={idPrefix} entry={editingEntry} client:load />
        <MeasurementBrowser
          entries={entries}
          readOnly={false}
          editingId={editingEntry?.id}
          confirmingId={confirmingEntry?.id}
          accountUserId={accountUserId}
          subjectTraineeId={subjectTraineeId}
          idPrefix={idPrefix}
          today={today}
          dates={dates}
          page={page}
          pageCount={pageCount}
          pageSize={pageSize}
          month={month}
          client:load
        />
      </>
    ) : (
      <ServerError message="Could not load your measurements" />
    )}
  </div>
</div>
