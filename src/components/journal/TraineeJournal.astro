---
import { ServerError } from "@/components/auth/ServerError";
import MeasurementForm from "@/components/measurements/MeasurementForm";
import MeasurementList from "@/components/measurements/MeasurementList.astro";
import type { MeasurementWithDeltas } from "@/types";

interface Props {
  measurementsLoaded: boolean;
  entries: MeasurementWithDeltas[];
  serverError: string | null;
  editingEntry?: MeasurementWithDeltas | null;
  idPrefix?: string;
}

const { measurementsLoaded, entries, serverError, editingEntry = null, idPrefix = "" } = Astro.props;

function editHref(entry: MeasurementWithDeltas): string {
  return `/measurements?edit=${encodeURIComponent(entry.id)}`;
}
---

<div class="flex justify-center px-4 pb-8">
  <!-- date w-36 + 8×w-28 + gaps + list padding + card padding + both borders -->
  <div
    class:list={[
      "rounded-2xl border border-border bg-card p-8 text-card-foreground",
      measurementsLoaded ? "w-max min-w-[calc(75rem+4px)]" : "w-max",
    ]}
  >
    <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">
      {editingEntry ? "Edit measurement" : "Add your next measurement"}
    </h1>
    {measurementsLoaded ? (
      <>
        <MeasurementForm serverError={serverError} idPrefix={idPrefix} entry={editingEntry} client:load />
        {entries.length === 0 ? (
          <p class="mt-6 text-sm text-muted-foreground">No measurements yet</p>
        ) : (
          <MeasurementList entries={entries} editHref={editHref} />
        )}
      </>
    ) : (
      <ServerError message="Could not load your measurements" />
    )}
  </div>
</div>
