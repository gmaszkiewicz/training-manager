---
import { Button } from "@/components/ui/button";
import packageJson from "../../package.json";

function libraryEntries(record: Record<string, string>): [string, string][] {
  return Object.entries(record).sort(([left], [right]) => left.localeCompare(right));
}

const dependencies = libraryEntries(packageJson.dependencies);
const devDependencies = libraryEntries(packageJson.devDependencies);
---

<footer
  class="border-border bg-card text-muted-foreground flex items-center justify-end rounded-xl border px-4 py-2 text-sm"
>
  <Button type="button" variant="ghost" data-app-libraries aria-haspopup="dialog">
    TM (v.{packageJson.version})
  </Button>
  <dialog
    class="bg-card text-card-foreground border-border m-auto w-full max-w-lg rounded-xl border p-6 shadow-md"
    data-app-libraries-dialog
    aria-labelledby="app-libraries-title"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="app-libraries-title" class="text-xl font-bold">{packageJson.name}</h2>
        <p class="text-muted-foreground text-sm">v.{packageJson.version}</p>
      </div>
      <Button type="button" variant="ghost" data-close>
        Close
      </Button>
    </div>
    <div class="mt-4 max-h-96 overflow-y-auto">
      <h3 class="text-sm font-semibold">Dependencies</h3>
      <ul class="mt-2 flex flex-col gap-1">
        {
          dependencies.map(([name, libraryVersion]) => (
            <li class="flex items-baseline justify-between gap-4 text-sm">
              <span>{name}</span>
              <span class="text-muted-foreground shrink-0">{libraryVersion}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="mt-4 text-sm font-semibold">Dev dependencies</h3>
      <ul class="mt-2 flex flex-col gap-1">
        {
          devDependencies.map(([name, libraryVersion]) => (
            <li class="flex items-baseline justify-between gap-4 text-sm">
              <span>{name}</span>
              <span class="text-muted-foreground shrink-0">{libraryVersion}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </dialog>
</footer>

<script>
  const trigger = document.querySelector("[data-app-libraries]");
  const dialog = document.querySelector("[data-app-libraries-dialog]");

  trigger?.addEventListener("click", () => {
    if (dialog instanceof HTMLDialogElement) {
      dialog.showModal();
    }
  });

  dialog?.addEventListener("click", (event) => {
    if (!(dialog instanceof HTMLDialogElement)) {
      return;
    }
    if (event.target === dialog) {
      dialog.close();
    }
  });

  dialog?.querySelector("[data-close]")?.addEventListener("click", () => {
    if (dialog instanceof HTMLDialogElement) {
      dialog.close();
    }
  });
</script>

<style>
  dialog::backdrop {
    background: var(--foreground);
    opacity: 0.2;
  }
</style>
