---
import Layout from "@/layouts/Layout.astro";
import TrainerPanel from "@/components/trainer/TrainerPanel.astro";
import FindTraineeDialog from "@/components/trainer/FindTraineeDialog";
import { measurementFields } from "@/lib/measurement-input";
import type { TrainerLink } from "@/lib/trainer-preview";
import type { FieldDelta, MeasurementField, MeasurementWithDeltas } from "@/types";

const sampleLink: TrainerLink = {
  traineeId: "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  email: "trainee@example.com",
  linkedAt: "2026-09-15T12:00:00.000Z",
  // Both names: the headings read "… for A. Lovelace (trainee@example.com)".
  firstName: "Ada",
  lastName: "Lovelace",
};

const secondLink: TrainerLink = {
  traineeId: "b2c3d4e5-f6a7-8901-bcde-f12345678901",
  email: "trainee-two@example.com",
  linkedAt: "2026-09-16T12:00:00.000Z",
  // One saved name: "… for Grace (trainee-two@example.com)". The long list has no names: the email alone.
  firstName: "Grace",
  lastName: null,
};

function longListLink(letter: string): TrainerLink {
  return {
    traineeId: `trainee-${letter}`,
    email: `trainee-${letter}@example.com`,
    linkedAt: "2026-09-15T12:00:00.000Z",
  };
}

const longListLinks = ["a", "b", "c", "d", "e", "f", "g"].map((letter) => longListLink(letter));
const longListSelected = longListLink("d");

const fieldValues = Object.fromEntries(
  measurementFields.map((definition, index) => [definition.field, 50 + index * 5 + 0.5]),
) as Record<MeasurementField, number>;

const deltas = Object.fromEntries(
  measurementFields.map((definition, index) => {
    const direction: FieldDelta["direction"] = index % 3 === 0 ? "up" : index % 3 === 1 ? "down" : "none";
    return [
      definition.field,
      {
        direction,
        difference: direction === "none" ? 0 : 0.5 + index * 0.1,
      } satisfies FieldDelta,
    ];
  }),
) as Record<MeasurementField, FieldDelta>;

const sampleEntry: MeasurementWithDeltas = {
  id: "sink-measurement-1",
  measured_on: "2026-09-15T12:00:00",
  created_at: "2026-09-15T12:00:00.000Z",
  note: "Felt strong after the session.",
  ...fieldValues,
  deltas,
};
---

<Layout title="Kitchen sink — trainer">
  <div class="bg-background text-foreground w-full flex-1">
    <div class="mx-auto flex max-w-kitchen-sink flex-col gap-12 px-4 py-10 sm:px-8">
      <header class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold">Kitchen sink — trainer</h1>
        <p class="text-muted-foreground text-sm">
          States for <code class="text-foreground">/measurements</code> trainer panel. Public review surface (not linked
          from the product).
        </p>
      </header>

      <section class="flex flex-col gap-4" aria-labelledby="state-find-trainee">
        <h2 id="state-find-trainee" class="border-border border-b pb-2 text-lg font-semibold">
          Find trainee dialog
        </h2>
        <p class="text-muted-foreground text-sm">
          The search-styled trigger (magnifier and "Find trainee") opens a centered dialog titled Find trainee with the
          subtitle "Request access to a trainee's dashboards", the email search with the placeholder "Find trainee by
          email, first name or last name", the "Request for" group (Measurements checked, Nutrition, Training and
          Planning disabled) and Request access. Default: Measurements checked and the button enabled. Unchecking
          Measurements disables Request access. A not found, pending, granted or failed answer keeps the dialog open and
          shows an error toast in the bottom corner of the screen; a sent answer closes the dialog and shows the notice
          toast. Esc or a click on the overlay closes it and focus returns to the trigger. Field ids use{" "}
          <code class="text-foreground">find-trainee-</code>.
        </p>
        <div>
          <FindTraineeDialog client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-default">
        <h2 id="state-default" class="border-border border-b pb-2 text-lg font-semibold">
          Default
        </h2>
        <p class="text-muted-foreground text-sm">
          TrainerPanel in trainer mode with links loaded, one sample measurement entry, and no server error. Find
          trainee is not a tile: it lives in the top bar (see Find trainee dialog above). The collapsible "Choose
          trainee" tile shows two trainees in a centered email field, the first array item selected, the left arrow
          disabled and the right arrow linking to the second trainee. The collapsible "Measurements for" tile holds the
          read-only list. <code class="text-foreground">today="2026-09-15"</code> keeps the sample row on screen. The
          sample row has no Edit or Delete link. The Charts tile is its own card below, charting the sample entry in
          local mode, and the read-only Top progression tile sits below it, with working period controls and
          "Circumferences" filter. Form ids are unprefixed.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[sampleLink, secondLink]}
          selectedLink={sampleLink}
          trainerMeasurementsLoaded={true}
          entries={[sampleEntry]}
          idPrefix=""
          today="2026-09-15"
          month="2026-09"
          chartEntries={[sampleEntry]}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-hover">
        <h2 id="state-hover" class="border-border border-b pb-2 text-lg font-semibold">
          Hover
        </h2>
        <p class="text-muted-foreground text-sm">
          In the Find trainee dialog above, Request access uses Button{" "}
          <code class="text-foreground">hover:bg-primary/90</code>. The email button and list rows use Button outline
          and default hover.
        </p>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-focus-visible">
        <h2 id="state-focus-visible" class="border-border border-b pb-2 text-lg font-semibold">
          Focus-visible
        </h2>
        <p class="text-muted-foreground text-sm">
          Tab reaches the email button and an enabled arrow in the Default panel above. The ring is the shared{" "}
          <code class="text-foreground">--ring</code> from Button. A disabled arrow is not in the tab order.
        </p>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-disabled">
        <h2 id="state-disabled" class="border-border border-b pb-2 text-lg font-semibold">
          Disabled
        </h2>
        <p class="text-muted-foreground text-sm">
          Both arrows are disabled on the one-trainee panel in Empty, no measurements.
        </p>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-long-list">
        <h2 id="state-long-list" class="border-border border-b pb-2 text-lg font-semibold">
          Long list
        </h2>
        <p class="text-muted-foreground text-sm">
          Seven trainees in array order from <code class="text-foreground">trainee-a@example.com</code> through{" "}
          <code class="text-foreground">trainee-g@example.com</code>, with{" "}
          <code class="text-foreground">trainee-d@example.com</code> selected. The open list scrolls and the current row
          moves toward the vertical center. The left arrow links to <code class="text-foreground">trainee-c</code> and
          the right arrow links to <code class="text-foreground">trainee-e</code>. Same sample entry and{" "}
          <code class="text-foreground">today="2026-09-15"</code> as Default, so the wide card renders. Form ids use{" "}
          <code class="text-foreground">idPrefix="long-list-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={longListLinks}
          selectedLink={longListSelected}
          trainerMeasurementsLoaded={true}
          entries={[sampleEntry]}
          idPrefix="long-list-"
          today="2026-09-15"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-links">
        <h2 id="state-empty-links" class="border-border border-b pb-2 text-lg font-semibold">
          Empty, zero links
        </h2>
        <p class="text-muted-foreground text-sm">
          Links loaded with an empty trainee list and no selected link, with Find trainee on: the "No trainees yet" card
          says "Request access to a trainee with Find trainee in the top bar." and has no Settings link. Form ids use{" "}
          <code class="text-foreground">idPrefix="links-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[]}
          selectedLink={null}
          trainerMeasurementsLoaded={true}
          entries={[]}
          idPrefix="links-"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-links-find-off">
        <h2 id="state-empty-links-find-off" class="border-border border-b pb-2 text-lg font-semibold">
          Empty, zero links, Find trainee off
        </h2>
        <p class="text-muted-foreground text-sm">
          Same as Empty, zero links with <code class="text-foreground">find-trainee</code> switched off: the "No
          trainees yet" card says "Request access to a trainee after switching Find trainee on in" and links to Settings
          → Components. Form ids use <code class="text-foreground">idPrefix="links-off-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[]}
          selectedLink={null}
          trainerMeasurementsLoaded={true}
          entries={[]}
          idPrefix="links-off-"
          shown={{ "find-trainee": { shown: false, preview: false } }}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-measurements">
        <h2 id="state-empty-measurements" class="border-border border-b pb-2 text-lg font-semibold">
          Empty, no measurements
        </h2>
        <p class="text-muted-foreground text-sm">
          One selected trainee with measurements loaded and empty entries, showing "No measurements yet". Form ids use{" "}
          <code class="text-foreground">idPrefix="empty-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[sampleLink]}
          selectedLink={sampleLink}
          trainerMeasurementsLoaded={true}
          entries={[]}
          idPrefix="empty-"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-month">
        <h2 id="state-empty-month" class="border-border border-b pb-2 text-lg font-semibold">
          Empty month
        </h2>
        <p class="text-muted-foreground text-sm">
          One selected trainee with the sample entry and <code class="text-foreground">today="2026-10-01"</code>. The
          date list includes 2026-10 and 2026-09. The selected month has no rows, so the copy is "No measurements in
          this month". No Edit or Delete link. <code class="text-foreground">idPrefix="empty-month-"</code> keeps the
          form and select ids off Default and Empty.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[sampleLink]}
          selectedLink={sampleLink}
          trainerMeasurementsLoaded={true}
          entries={[sampleEntry]}
          idPrefix="empty-month-"
          today="2026-10-01"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-error-query">
        <h2 id="state-error-query" class="border-border border-b pb-2 text-lg font-semibold">
          Error, query
        </h2>
        <p class="text-muted-foreground text-sm">
          Same as Default with <code class="text-foreground">serverError="No trainee with that email"</code> (the
          redirect answer of a request without JavaScript), shown as an error toast,{" "}
          <code class="text-foreground">today="2026-09-15"</code>, and{" "}
          <code class="text-foreground">idPrefix="error-query-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError="No trainee with that email"
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[sampleLink]}
          selectedLink={sampleLink}
          trainerMeasurementsLoaded={true}
          entries={[sampleEntry]}
          idPrefix="error-query-"
          today="2026-09-15"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notice-requested">
        <h2 id="state-notice-requested" class="border-border border-b pb-2 text-lg font-semibold">
          Notice, request sent
        </h2>
        <p class="text-muted-foreground text-sm">
          Zero links with <code class="text-foreground">requestedEmail="trainee@example.com"</code>, showing a notice
          toast "Your request for read access to measurements has been sent to trainee@example.com". Form ids use{" "}
          <code class="text-foreground">idPrefix="notice-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail="trainee@example.com"
          trainerLinksLoaded={true}
          trainerLinks={[]}
          selectedLink={null}
          trainerMeasurementsLoaded={true}
          entries={[]}
          idPrefix="notice-"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-error-trainees">
        <h2 id="state-error-trainees" class="border-border border-b pb-2 text-lg font-semibold">
          Error, trainees
        </h2>
        <p class="text-muted-foreground text-sm">
          <code class="text-foreground">{"trainerLinksLoaded={false}"}</code> so no tile or card renders and a toast
          shows "Could not load trainees".
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={false}
          trainerLinks={[]}
          selectedLink={null}
          trainerMeasurementsLoaded={true}
          entries={[]}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-error-measurements">
        <h2 id="state-error-measurements" class="border-border border-b pb-2 text-lg font-semibold">
          Error, measurements
        </h2>
        <p class="text-muted-foreground text-sm">
          One selected trainee with <code class="text-foreground">{"trainerMeasurementsLoaded={false}"}</code>, showing
          a toast "Could not load measurements". Form ids use{" "}
          <code class="text-foreground">idPrefix="error-measurements-"</code>.
        </p>
        <TrainerPanel
          mode="trainer"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={true}
          trainerLinks={[sampleLink]}
          selectedLink={sampleLink}
          trainerMeasurementsLoaded={false}
          entries={[]}
          idPrefix="error-measurements-"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-unavailable">
        <h2 id="state-unavailable" class="border-border border-b pb-2 text-lg font-semibold">
          Unavailable
        </h2>
        <p class="text-muted-foreground text-sm">
          <code class="text-foreground">mode="unavailable"</code>: heading "Measurements" and a toast "Could not open
          your journal".
        </p>
        <TrainerPanel
          mode="unavailable"
          serverError={null}
          requestedEmail={null}
          trainerLinksLoaded={false}
          trainerLinks={[]}
          selectedLink={null}
          trainerMeasurementsLoaded={false}
          entries={[]}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-loading">
        <h2 id="state-loading" class="border-border border-b pb-2 text-lg font-semibold">
          Loading
        </h2>
        <p class="text-muted-foreground text-sm">N/A because the panel renders only after the server calls return.</p>
      </section>
    </div>
  </div>
</Layout>
