---
import Layout from "@/layouts/Layout.astro";
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import ChartsTile from "@/components/measurements/ChartsTile.astro";
import TopChangesTile from "@/components/measurements/TopChangesTile.astro";
import JournalSinkStates from "@/components/kitchen-sink/JournalSinkStates";
import { withDeltas } from "@/lib/measurement-deltas";
import { measurementFields } from "@/lib/measurement-input";
import type { FieldDelta, MeasurementField, MeasurementWithDeltas } from "@/types";

const fieldValues = Object.fromEntries(
  measurementFields.map((definition, index) => [definition.field, 50 + index * 5 + 0.5]),
) as Record<MeasurementField, number>;

const deltas = Object.fromEntries(
  measurementFields.map((definition, index) => {
    const direction: FieldDelta["direction"] = index % 3 === 0 ? "up" : index % 3 === 1 ? "down" : "none";
    return [
      definition.field,
      {
        direction,
        difference: direction === "none" ? 0 : 0.5 + index * 0.1,
      } satisfies FieldDelta,
    ];
  }),
) as Record<MeasurementField, FieldDelta>;

const sampleEntry: MeasurementWithDeltas = {
  id: "sink-measurement-1",
  measured_on: "2026-09-15T12:00:00",
  created_at: "2026-09-15T12:00:00.000Z",
  note: "Felt strong after the session. Waist stayed flat and chest came down a little, which matches how the shirt fits.",
  ...fieldValues,
  deltas,
};

const chartDays = [
  "2026-08-28T07:30:00",
  "2026-09-02T07:15:00",
  "2026-09-09T07:40:00",
  "2026-09-16T07:20:00",
  "2026-09-23T07:35:00",
  "2026-09-29T07:10:00",
];
const chartWaves = [0, 1.2, -0.6, 0.9, -1.1, 0.4];

const chartEntries: MeasurementWithDeltas[] = withDeltas(
  chartDays.map((measuredOn, step) => ({
    id: `sink-chart-${String(step + 1)}`,
    measured_on: measuredOn,
    created_at: `${measuredOn}.000Z`,
    note: null,
    ...(Object.fromEntries(
      measurementFields.map((definition, index) => [
        definition.field,
        Math.round((fieldValues[definition.field] + chartWaves[(step + index) % chartWaves.length] - step * 0.3) * 10) /
          10,
      ]),
    ) as Record<MeasurementField, number>),
  })),
).reverse();

// Three October entries where every field only drops, so the gain charts have nothing to show. Odd fields drop most
// in the week of 12 Oct, even fields in the week of 19 Oct, so the loss series peak on different axes.
const lossDays = ["2026-10-05T07:30:00", "2026-10-12T07:20:00", "2026-10-19T07:40:00"];
const lossDrops = [
  [0, 0.5, 1.5],
  [0, 1.3, 1.6],
];
const lossEntries: MeasurementWithDeltas[] = withDeltas(
  lossDays.map((measuredOn, step) => ({
    id: `sink-loss-${String(step + 1)}`,
    measured_on: measuredOn,
    created_at: `${measuredOn}.000Z`,
    note: null,
    ...(Object.fromEntries(
      measurementFields.map((definition, index) => [
        definition.field,
        Math.round((fieldValues[definition.field] - lossDrops[index % 2][step]) * 10) / 10,
      ]),
    ) as Record<MeasurementField, number>),
  })),
).reverse();

// Top progression 0.9: two entries, so December changes only on the 12th. Even fields rise and odd fields drop, so
// every chart has one progress day and the day axes are labelled 1, 7, 12, 19, 25 and 31.
const singleDayEntries: MeasurementWithDeltas[] = withDeltas(
  ["2026-11-28T07:30:00", "2026-12-12T07:20:00"].map((measuredOn, step) => ({
    id: `sink-single-day-${String(step + 1)}`,
    measured_on: measuredOn,
    created_at: `${measuredOn}.000Z`,
    note: null,
    ...(Object.fromEntries(
      measurementFields.map((definition, index) => [
        definition.field,
        Math.round((fieldValues[definition.field] + step * (index % 2 === 0 ? 0.8 : -0.6)) * 10) / 10,
      ]),
    ) as Record<MeasurementField, number>),
  })),
).reverse();

// Top progression 0.9: two July entries with the same values, so the month has measurements but no progress.
const noProgressEntries: MeasurementWithDeltas[] = withDeltas(
  ["2026-07-03T07:30:00", "2026-07-20T07:20:00"].map((measuredOn, step) => ({
    id: `sink-no-progress-${String(step + 1)}`,
    measured_on: measuredOn,
    created_at: `${measuredOn}.000Z`,
    note: null,
    ...fieldValues,
  })),
).reverse();
---

<Layout title="Kitchen sink — journal">
  <div class="bg-background text-foreground w-full flex-1">
    <div class="mx-auto flex max-w-kitchen-sink flex-col gap-12 px-4 py-10 sm:px-8">
      <header class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold">Kitchen sink — journal</h1>
        <p class="text-muted-foreground text-sm">
          States for <code class="text-foreground">/measurements</code> trainee journal. Public review surface (not
          linked from the product).
        </p>
      </header>

      <section class="flex flex-col gap-4" aria-labelledby="state-default">
        <h2 id="state-default" class="border-border border-b pb-2 text-lg font-semibold">
          Default
        </h2>
        <p class="text-muted-foreground text-sm">
          TraineeJournal with measurements loaded, one sample entry (every field, note, and deltas), and no server
          error. It renders two collapsible tiles: "New measurement" (the add form, open) and "Your measurements" (the
          list, open). <code class="text-foreground">today="2026-09-15"</code> keeps the sample row on screen. The
          sample row shows selection checkboxes, metric and note headers with an icon, and a row actions menu with Edit
          and Delete. The add form starts with the sample entry's weight and circumferences; the note and the date and
          time stay empty. Form ids are unprefixed.
        </p>
        <TraineeJournal
          measurementsLoaded={true}
          entries={[sampleEntry]}
          serverError={null}
          today="2026-09-15"
          previousEntry={sampleEntry}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-edit">
        <h2 id="state-edit" class="border-border border-b pb-2 text-lg font-semibold">
          Edit
        </h2>
        <p class="text-muted-foreground text-sm">
          TraineeJournal with <code class="text-foreground">editingEntry</code> set to the sample entry: a
          non-collapsible "Edit measurement" card with the edit form takes the place of the New measurement tile, above
          the Measurements tile. <code class="text-foreground">idPrefix="edit-"</code> keeps its ids off Default.
        </p>
        <TraineeJournal
          measurementsLoaded={true}
          entries={[sampleEntry]}
          serverError={null}
          today="2026-09-15"
          editingEntry={sampleEntry}
          idPrefix="edit-"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-charts-default">
        <h2 id="state-charts-default" class="border-border border-b pb-2 text-lg font-semibold">
          Charts, default
        </h2>
        <p class="text-muted-foreground text-sm">
          ChartsTile open in local mode, headed "Monthly progression" with the muted note "Shows the last entry of each
          day", with six sample entries from 28 Aug to 29 Sep 2026 and{" "}
          <code class="text-foreground">today="2026-09-30"</code>. Month mode charts the five September entries, one
          chart per field in its own <code class="text-foreground">--chart-1..8</code> colour. The first September
          entry's tooltip difference is against the August entry. Week / Month / Year / Years and previous/next work on
          the same data. The period picker lists only the weeks, months and years that have entries, and Years shows a
          fixed, disabled "Last 5 years" box. Each point sits on its day, month or year tick, and the tooltip names the
          entry its difference is against. On <code class="text-foreground">/measurements</code> the tile is its own
          card below the Measurements tile.
        </p>
        <ChartsTile readOnly={false} month="2026-09" today="2026-09-30" startsOpen={true} entries={chartEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-charts-closed">
        <h2 id="state-charts-closed" class="border-border border-b pb-2 text-lg font-semibold">
          Charts, closed
        </h2>
        <p class="text-muted-foreground text-sm">
          ChartsTile with <code class="text-foreground">{"startsOpen={false}"}</code>: only the summary, here rendered
          with <code class="text-foreground">initialPeriod="week"</code> ("Weekly progression", "Shows the last entry of
          each day"), and its chevron.
        </p>
        <ChartsTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={false}
          entries={chartEntries}
          initialPeriod="week"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-charts-empty">
        <h2 id="state-charts-empty" class="border-border border-b pb-2 text-lg font-semibold">
          Charts, empty period
        </h2>
        <p class="text-muted-foreground text-sm">
          The same entries with <code class="text-foreground">month="2026-11"</code> and{" "}
          <code class="text-foreground">today="2026-11-15"</code>, so November shows "No measurements in this period".
        </p>
        <ChartsTile readOnly={false} month="2026-11" today="2026-11-15" startsOpen={true} entries={chartEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-charts-loading">
        <h2 id="state-charts-loading" class="border-border border-b pb-2 text-lg font-semibold">
          Charts, loading
        </h2>
        <p class="text-muted-foreground text-sm">
          ChartsTile with <code class="text-foreground">forceLoading</code>, showing "Loading charts…" as it does before
          the first chart read returns.
        </p>
        <ChartsTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={true}
          entries={[]}
          forceLoading={true}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-default">
        <h2 id="state-top-default" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, default
        </h2>
        <p class="text-muted-foreground text-sm">
          TopChangesTile open in local mode, headed "Top progression" with the muted note "Summed changes versus the
          previous entry", on the same six entries and <code class="text-foreground">today="2026-09-30"</code>, so
          September holds five changes per field, one per calendar week, the first one against 28 Aug. Four radar charts
          in a 2×2 grid on wide screens and one column on narrow ones: top weight gain and top circumference gain on
          top, top weight loss and top circumference loss below. Every radar has an axis per sub-period of the period:
          here the calendar weeks of September clipped to the month (1–6 Sep … 28–30 Sep); a week has its 7 dates, a
          year its 12 months, Years its 5 years. Each value is the sum of the gains (or drops) in that sub-period, 0
          when none. A circumference radar overlays one series per selected field in its line-chart colour (
          <code class="text-foreground">--chart-2..8</code>); a weight radar has one series in{" "}
          <code class="text-foreground">--chart-1</code>. Each series' top sub-period gets a larger dot, and the legend
          names every changed series with it and its signed value, e.g. "Waist · 14–20 Sep +1.2 cm". A gain and a loss
          radar share one scale. The tooltip shows the sub-period and, per series, the signed value and how many changes
          it adds up. The "Circumferences" menu filters both circumference charts; the last checked field is disabled.
        </p>
        <TopChangesTile readOnly={false} month="2026-09" today="2026-09-30" startsOpen={true} entries={chartEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-closed">
        <h2 id="state-top-closed" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, closed
        </h2>
        <p class="text-muted-foreground text-sm">
          TopChangesTile with <code class="text-foreground">{"startsOpen={false}"}</code>: only the summary and its
          chevron.
        </p>
        <TopChangesTile readOnly={false} month="2026-09" today="2026-09-30" startsOpen={false} entries={chartEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-empty">
        <h2 id="state-top-empty" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, empty period
        </h2>
        <p class="text-muted-foreground text-sm">
          The same entries with <code class="text-foreground">month="2026-11"</code> and{" "}
          <code class="text-foreground">today="2026-11-15"</code>, so November shows "No measurements in this period"
          once, in place of the grid.
        </p>
        <TopChangesTile readOnly={false} month="2026-11" today="2026-11-15" startsOpen={true} entries={chartEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-losses">
        <h2 id="state-top-losses" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, losses only
        </h2>
        <p class="text-muted-foreground text-sm">
          Three October entries where every field drops, so both gain cards keep their title and say "No gains in this
          period", while both loss radars show their series: weight and every other field drop most in the week of 19
          Oct, the rest in the week of 12 Oct, and the legends name those weeks.
        </p>
        <TopChangesTile readOnly={false} month="2026-10" today="2026-10-31" startsOpen={true} entries={lossEntries} />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-filtered">
        <h2 id="state-top-filtered" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, filtered circumferences
        </h2>
        <p class="text-muted-foreground text-sm">
          TopChangesTile with <code class="text-foreground">initialFields</code> set to waist, hips and navel, so both
          circumference radars draw only those three series, rescaled to the pair's largest sum. Unchecking down to one
          field disables its checkbox.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={true}
          entries={chartEntries}
          initialFields={["waist_cm", "hips_cm", "navel_cm"]}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-loading">
        <h2 id="state-top-loading" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression, loading
        </h2>
        <p class="text-muted-foreground text-sm">
          TopChangesTile with <code class="text-foreground">forceLoading</code>, showing "Loading charts…" as it does
          before the first chart read returns.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={true}
          entries={[]}
          forceLoading={true}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-rc-default">
        <h2 id="state-top-rc-default" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression 0.9 (RC), populated month
        </h2>
        <p class="text-muted-foreground text-sm">
          TopChangesTile with <code class="text-foreground">version="0.9"</code> on the same six entries as the default
          0.1 tile. The month picker sits on the left and the Week/Month/Year/Years box on the right, with "Previous
          chart period" and "Next chart period" arrows: ‹ is disabled on Week and › on Years, and the list offers all
          four. On a phone the row wraps. Month radars have one axis per day of September, labelled only on the days
          with a change (2, 9, 16, 23 and 29), and each legend entry names its series' top day, e.g. "Wed 16 Sep". Each
          circumference chart has its own filter icon ("Filter circumferences: Top circumference gain" and "… loss");
          the weight charts have none.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={true}
          entries={chartEntries}
          version="0.9"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-rc-single-day">
        <h2 id="state-top-rc-single-day" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression 0.9 (RC), single progress day
        </h2>
        <p class="text-muted-foreground text-sm">
          Two entries, 28 Nov and 12 Dec, with <code class="text-foreground">month="2026-12"</code>: December changes
          only on the 12th, so every radar has 31 day axes labelled 1, 7, 12, 19, 25 and 31, and each legend names "Sat
          12 Dec". Weight, waist, thigh and hips rise; chest, arm, calf and navel drop.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-12"
          today="2026-12-31"
          startsOpen={true}
          entries={singleDayEntries}
          version="0.9"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-rc-no-progress">
        <h2 id="state-top-rc-no-progress" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression 0.9 (RC), no progress
        </h2>
        <p class="text-muted-foreground text-sm">
          Two July entries with the same values: the month has measurements but no change, so the four cards say "No
          gains in this period" and "No losses in this period". The circumference cards keep their filter icons.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-07"
          today="2026-07-31"
          startsOpen={true}
          entries={noProgressEntries}
          version="0.9"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-top-rc-filtered">
        <h2 id="state-top-rc-filtered" class="border-border border-b pb-2 text-lg font-semibold">
          Top progression 0.9 (RC), filtered circumferences
        </h2>
        <p class="text-muted-foreground text-sm">
          <code class="text-foreground">initialGainFields</code> set to waist, hips and navel and{" "}
          <code class="text-foreground">initialLossFields</code> to chest and arm, so each circumference radar draws
          only its own selection, and the pair shares one scale over the union of both. Changing one chart's filter
          leaves the other alone.
        </p>
        <TopChangesTile
          readOnly={false}
          month="2026-09"
          today="2026-09-30"
          startsOpen={true}
          entries={chartEntries}
          version="0.9"
          initialGainFields={["waist_cm", "hips_cm", "navel_cm"]}
          initialLossFields={["chest_cm", "arms_cm"]}
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-hover">
        <h2 id="state-hover" class="border-border border-b pb-2 text-lg font-semibold">
          Hover
        </h2>
        <p class="text-muted-foreground text-sm">
          Submit uses Button <code class="text-foreground">hover:bg-primary/90</code>. The row actions button in the
          Default journal uses the ghost button hover, and its menu items use the shared accent hover. The measurement
          row uses the data-table hover.
        </p>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-focus-visible">
        <h2 id="state-focus-visible" class="border-border border-b pb-2 text-lg font-semibold">
          Focus-visible
        </h2>
        <p class="text-muted-foreground text-sm">
          Tab through the date field, one measurement field, the note, the submit button, the row selection checkbox,
          and the row actions button in the Default journal above. The ring is the shared{" "}
          <code class="text-foreground">--ring</code>.
        </p>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-disabled">
        <h2 id="state-disabled" class="border-border border-b pb-2 text-lg font-semibold">
          Disabled
        </h2>
        <p class="text-muted-foreground text-sm">
          SubmitButton with <code class="text-foreground">forcePending</code> so the control is disabled, showing
          "Adding measurement...". MeasurementForm does not pass <code class="text-foreground">forcePending</code>.
        </p>
        <JournalSinkStates client:load variant="disabled" />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-error">
        <h2 id="state-error" class="border-border border-b pb-2 text-lg font-semibold">
          Error
        </h2>
        <p class="text-muted-foreground text-sm">
          TraineeJournal with measurements not loaded: a "New measurement" card with the toast "Could not load your
          measurements", form and list absent. FormField with a field error; id is sink-scoped so it does not collide
          with the Default form.
        </p>
        <TraineeJournal measurementsLoaded={false} entries={[]} serverError={null} />
        <JournalSinkStates client:load variant="error" />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty">
        <h2 id="state-empty" class="border-border border-b pb-2 text-lg font-semibold">
          Empty
        </h2>
        <p class="text-muted-foreground text-sm">
          TraineeJournal with measurements loaded, empty entries, and{" "}
          <code class="text-foreground">idPrefix="empty-"</code> so "No measurements yet" shows under a second form
          whose ids do not collide with Default. With no earlier entry, the add form fields start empty.
        </p>
        <TraineeJournal measurementsLoaded={true} entries={[]} serverError={null} idPrefix="empty-" />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-day">
        <h2 id="state-empty-day" class="border-border border-b pb-2 text-lg font-semibold">
          Empty month
        </h2>
        <p class="text-muted-foreground text-sm">
          TraineeJournal with the sample entry and <code class="text-foreground">today="2026-10-01"</code>. The date
          list includes 2026-10 and 2026-09. The selected month has no rows, so the copy is "No measurements in this
          month". <code class="text-foreground">idPrefix="empty-day-"</code> keeps the form and select ids off Default
          and Empty.
        </p>
        <TraineeJournal
          measurementsLoaded={true}
          entries={[sampleEntry]}
          serverError={null}
          idPrefix="empty-day-"
          today="2026-10-01"
        />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-loading">
        <h2 id="state-loading" class="border-border border-b pb-2 text-lg font-semibold">
          Loading
        </h2>
        <p class="text-muted-foreground text-sm">
          SubmitButton with <code class="text-foreground">forcePending</code> showing "Adding measurement..." and the
          spinner. A separate measurements-loading state is N/A because the journal renders only after the server call
          returns.
        </p>
        <JournalSinkStates client:load variant="loading" />
      </section>
    </div>
  </div>
</Layout>
