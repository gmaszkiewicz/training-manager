---
import Layout from "@/layouts/Layout.astro";
import CollaborationsList from "@/components/hub/CollaborationsList.astro";
import NotificationsTable from "@/components/hub/NotificationsTable";
import PageErrorToasts from "@/components/measurements/PageErrorToasts";
import { collaborationErrorMessage, requestOutcomeMessage } from "@/lib/collaborations";
import { notificationErrorMessage, notificationNoticeMessage } from "@/lib/notifications";
import type { AppNotification, Collaboration, CollaborationPage, NotificationKind, NotificationPage } from "@/types";

const pendingTrainee: Collaboration = {
  otherId: "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  name: "trainee@example.com",
  email: "trainee@example.com",
  access: {
    measurements: [{ type: "read", pending: true }],
    nutrition: [],
    training: [],
    planning: [],
  },
  linkedAt: "2026-10-20T12:00:00.000Z",
};

const linkedTrainee: Collaboration = {
  otherId: "b2c3d4e5-f6a7-8901-bcde-f12345678901",
  name: "A. Lovelace",
  email: "ada@example.com",
  access: {
    measurements: [{ type: "read", pending: false }],
    nutrition: [],
    training: [],
    planning: [],
  },
  linkedAt: "2026-10-18T12:00:00.000Z",
};

const pendingTrainer: Collaboration = {
  otherId: "c3d4e5f6-a7b8-9012-cdef-123456789012",
  name: "G. Hopper",
  email: "grace@example.com",
  access: {
    measurements: [{ type: "read", pending: true }],
    nutrition: [],
    training: [],
    planning: [],
  },
  linkedAt: "2026-10-21T12:00:00.000Z",
};

const linkedTrainer: Collaboration = {
  otherId: "d4e5f6a7-b8c9-0123-def1-234567890123",
  name: "trainer@example.com",
  email: "trainer@example.com",
  access: {
    measurements: [{ type: "read", pending: false }],
    nutrition: [],
    training: [],
    planning: [],
  },
  linkedAt: "2026-10-01T12:00:00.000Z",
};

const trainerMixed: CollaborationPage = {
  rows: [pendingTrainee, linkedTrainee],
  page: 1,
  pageCount: 1,
  pageSize: 5,
};

const traineePending: CollaborationPage = {
  rows: [pendingTrainer, linkedTrainer],
  page: 1,
  pageCount: 1,
  pageSize: 5,
};

const emptyPage: CollaborationPage = { rows: [], page: 1, pageCount: 1, pageSize: 5 };

function pagedTrainee(letter: string): Collaboration {
  return {
    otherId: `e5f6a7b8-c9d0-1234-ef12-34567890abc${letter}`,
    name: `trainee-${letter}@example.com`,
    email: `trainee-${letter}@example.com`,
    access: {
      measurements: [{ type: "read", pending: false }],
      nutrition: [],
      training: [],
      planning: [],
    },
    linkedAt: "2026-09-15T12:00:00.000Z",
  };
}

const multiPage: CollaborationPage = {
  rows: ["a", "b", "c", "d", "e"].map((letter) => pagedTrainee(letter)),
  page: 2,
  pageCount: 3,
  pageSize: 5,
};

const confirmPage: CollaborationPage = {
  rows: [linkedTrainee],
  page: 1,
  pageCount: 1,
  pageSize: 5,
};

const sentNotice = requestOutcomeMessage("sent", "trainee@example.com");
const updateError = collaborationErrorMessage("failed") ?? "";

interface SampleActor {
  role: "trainer" | "trainee";
  firstName: string | null;
  lastName: string | null;
  email: string;
}

function sampleNotification(index: number, kind: NotificationKind, actor: SampleActor, read: boolean): AppNotification {
  const createdAt = new Date(Date.UTC(2026, 9, 27 - index, 9 + (index % 10), 15)).toISOString();
  return {
    id: `f6a7b8c9-d0e1-2345-f123-4567890abc${String(index).padStart(2, "0")}`,
    kind,
    actorRole: actor.role,
    actorFirstName: actor.firstName,
    actorLastName: actor.lastName,
    actorEmail: actor.email,
    createdAt,
    readAt: read ? createdAt : null,
  };
}

const hopper: SampleActor = { role: "trainer", firstName: "Grace", lastName: "Hopper", email: "grace@example.com" };
const lovelace: SampleActor = { role: "trainee", firstName: "Ada", lastName: "Lovelace", email: "ada@example.com" };
const emailOnly: SampleActor = { role: "trainee", firstName: null, lastName: null, email: "trainee@example.com" };

const mixedRows: AppNotification[] = [
  sampleNotification(0, "link_requested", hopper, false),
  sampleNotification(1, "link_accepted", lovelace, false),
  sampleNotification(2, "link_declined", emailOnly, true),
  sampleNotification(3, "link_cancelled", hopper, true),
  sampleNotification(4, "link_removed", lovelace, true),
];

const mixedNotifications: NotificationPage = { rows: mixedRows, page: 1, pageCount: 1, size: 5, total: 5 };
const emptyNotifications: NotificationPage = { rows: [], page: 1, pageCount: 1, size: 5, total: 0 };

const sampleKinds: NotificationKind[] = [
  "link_requested",
  "link_accepted",
  "link_declined",
  "link_cancelled",
  "link_removed",
];
const multiPageNotifications: NotificationPage = {
  rows: Array.from({ length: 10 }, (_, index) =>
    sampleNotification(
      10 + index,
      sampleKinds[index % sampleKinds.length],
      index % 2 === 0 ? hopper : lovelace,
      index > 3,
    ),
  ),
  page: 2,
  pageCount: 3,
  size: 10,
  total: 27,
};

const selectedNotificationIds = [mixedRows[0].id, mixedRows[2].id];
const readNotice = notificationNoticeMessage("read") ?? "";
const deletedNotice = notificationNoticeMessage("deleted") ?? "";
const notificationsError = notificationErrorMessage("failed") ?? "";
---

<Layout title="Kitchen sink — hub">
  <div class="bg-background text-foreground w-full flex-1">
    <div class="mx-auto flex max-w-kitchen-sink flex-col gap-12 px-4 py-10 sm:px-8">
      <header class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold">Kitchen sink — hub</h1>
        <p class="text-muted-foreground text-sm">
          States for the <code class="text-foreground">/hub/collaborations</code> list and the{" "}
          <code class="text-foreground">/hub/notifications</code> table. Public review surface (not linked from the
          product). Row actions post to the real routes and need a session.
        </p>
      </header>

      <section class="flex flex-col gap-4" aria-labelledby="state-trainer-mixed">
        <h2 id="state-trainer-mixed" class="border-border border-b pb-2 text-lg font-semibold">
          Trainer, pending and linked
        </h2>
        <p class="text-muted-foreground text-sm">
          A table in the measurements style (muted header row with icons above the labels: PersonStanding Trainee, Link2
          Status; Dumbbell for Trainer on the trainee side). A pending trainee with no saved names (the email is shown
          once) above a linked trainee "A. Lovelace" with the email below. Pending rows offer Cancel request; linked
          rows offer Unlink, which links to <code class="text-foreground">?page=1&amp;confirm=&lt;id&gt;</code>. Always
          five rows per page, with no page-size control; no pager on one page. Every row keeps one height: the name and
          the email take one line each, cut with "…" (the full text in the title), and the fixed table layout keeps
          Status and the actions in view; when the list is narrower than 32rem (a container query, so it also applies in
          these narrow cards) the actions move into an ellipsis menu ("Actions for …"), as on the measurement rows.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainer" page={trainerMixed} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-trainee-pending">
        <h2 id="state-trainee-pending" class="border-border border-b pb-2 text-lg font-semibold">
          Trainee, pending request
        </h2>
        <p class="text-muted-foreground text-sm">
          A pending request from "G. Hopper" with ✓ accept and ✕ decline icon buttons (labels "Accept request from G.
          Hopper" and "Decline request from G. Hopper"), above a linked trainer with Remove.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainee" page={traineePending} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-trainer">
        <h2 id="state-empty-trainer" class="border-border border-b pb-2 text-lg font-semibold">
          Empty, trainer
        </h2>
        <p class="text-muted-foreground text-sm">
          No rows: "No trainees yet. Find a trainee by email on Measurements." with a link to{" "}
          <code class="text-foreground">/measurements</code>. No table.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainer" page={emptyPage} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-empty-trainee">
        <h2 id="state-empty-trainee" class="border-border border-b pb-2 text-lg font-semibold">
          Empty, trainee
        </h2>
        <p class="text-muted-foreground text-sm">No rows: "No trainers yet." No table.</p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainee" page={emptyPage} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-multi-page">
        <h2 id="state-multi-page" class="border-border border-b pb-2 text-lg font-semibold">
          Multi-page
        </h2>
        <p class="text-muted-foreground text-sm">
          Five linked trainees on page 2 of 3. Previous links to <code class="text-foreground">?page=1</code> and Next
          to <code class="text-foreground">?page=3</code>; on the first or last page that arrow is a disabled button.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainer" page={multiPage} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-confirm-unlink">
        <h2 id="state-confirm-unlink" class="border-border border-b pb-2 text-lg font-semibold">
          Confirm unlink
        </h2>
        <p class="text-muted-foreground text-sm">
          <code class="text-foreground">confirm</code> matches the linked row, so the bottom-right alert dialog reads
          "Unlink A. Lovelace? You will no longer see their measurements." with a focused Unlink button and a Cancel
          link back to <code class="text-foreground">?page=1</code>. The trainee copy is "Remove &lt;name&gt;? They will
          no longer see your measurements." A <code class="text-foreground">confirm</code> that matches no linked row on
          the page is ignored.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-xl border p-4">
          <CollaborationsList viewerRole="trainer" page={confirmPage} confirm={linkedTrainee.otherId} />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notice">
        <h2 id="state-notice" class="border-border border-b pb-2 text-lg font-semibold">
          Notice toast
        </h2>
        <p class="text-muted-foreground text-sm">
          A notice toast "{sentNotice}". Hub action notices ("Request accepted", "Trainee unlinked", …) use the same
          tone.
        </p>
        <PageErrorToasts messages={[sentNotice]} tone="notice" client:load />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-error">
        <h2 id="state-error" class="border-border border-b pb-2 text-lg font-semibold">
          Error toast
        </h2>
        <p class="text-muted-foreground text-sm">
          Error toasts "{updateError}" (a failed action) and "Could not load collaborations" (the list could not be
          read; the card stays empty).
        </p>
        <PageErrorToasts messages={[updateError, "Could not load collaborations"]} client:load />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-mixed">
        <h2 id="state-notifications-mixed" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, read and unread
        </h2>
        <p class="text-muted-foreground text-sm">
          Columns: a select checkbox, Notification, Received (UTC date over time) and Status. Unread rows show a dot, a
          bold message and a bold "Unread"; read rows are muted. Each message is a button that posts the row id to{" "}
          <code class="text-foreground">/api/notifications/open</code>, which marks it read and opens Collaborations.
          Mark as read and Delete stay disabled with no selection. Entries per page (5, 10, 15, the current one pressed)
          goes to <code class="text-foreground">?page=1&amp;size=N</code>. The header checkbox selects every visible
          row.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-measurement rounded-xl border p-4">
          <NotificationsTable page={mixedNotifications} client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-narrow">
        <h2 id="state-notifications-narrow" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, narrow
        </h2>
        <p class="text-muted-foreground text-sm">
          The same table in a phone-width card: below 32rem (a container query) the Received and Status columns are
          hidden, and the date, time and status show in a small line under each message.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-xs rounded-xl border p-4">
          <NotificationsTable page={mixedNotifications} client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-empty">
        <h2 id="state-notifications-empty" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, empty
        </h2>
        <p class="text-muted-foreground text-sm">No rows: "No notifications". No table; the actions are disabled.</p>
        <div class="border-border bg-card text-card-foreground w-full max-w-measurement rounded-xl border p-4">
          <NotificationsTable page={emptyNotifications} client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-multi-page">
        <h2 id="state-notifications-multi-page" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, multi-page
        </h2>
        <p class="text-muted-foreground text-sm">
          Ten rows on page 2 of 3 at size 10. Previous links to <code class="text-foreground">?page=1&amp;size=10</code>{" "}
          and Next to <code class="text-foreground">?page=3&amp;size=10</code>; on the first or last page that arrow is
          a disabled button.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-measurement rounded-xl border p-4">
          <NotificationsTable page={multiPageNotifications} client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-selected">
        <h2 id="state-notifications-selected" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, some selected
        </h2>
        <p class="text-muted-foreground text-sm">
          Two of five rows selected: the header checkbox is indeterminate and Mark as read and Delete are enabled. Each
          posts the selected <code class="text-foreground">ids</code> with <code class="text-foreground">page</code> and{" "}
          <code class="text-foreground">size</code>.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-measurement rounded-xl border p-4">
          <NotificationsTable page={mixedNotifications} initialSelectedIds={selectedNotificationIds} client:load />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-confirm">
        <h2 id="state-notifications-confirm" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, confirm delete
        </h2>
        <p class="text-muted-foreground text-sm">
          Delete opens the bottom-right alert dialog "Delete 2 notifications for good?" with a Delete button (focused
          when opened from the toolbar) that posts to <code class="text-foreground">/api/notifications/delete</code>,
          and a Cancel action (or Escape) that closes it.
        </p>
        <div class="border-border bg-card text-card-foreground w-full max-w-measurement rounded-xl border p-4">
          <NotificationsTable
            page={mixedNotifications}
            initialSelectedIds={selectedNotificationIds}
            initialConfirmOpen
            client:load
          />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-notice">
        <h2 id="state-notifications-notice" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, notice toast
        </h2>
        <p class="text-muted-foreground text-sm">
          Notice toasts "{readNotice}" and "{deletedNotice}".
        </p>
        <PageErrorToasts messages={[readNotice, deletedNotice]} tone="notice" client:load />
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-notifications-error">
        <h2 id="state-notifications-error" class="border-border border-b pb-2 text-lg font-semibold">
          Notifications, error toast
        </h2>
        <p class="text-muted-foreground text-sm">
          Error toasts "{notificationsError}" (a failed action) and "Could not load notifications" (the table could not
          be read; the card stays empty).
        </p>
        <PageErrorToasts messages={[notificationsError, "Could not load notifications"]} client:load />
      </section>
    </div>
  </div>
</Layout>
