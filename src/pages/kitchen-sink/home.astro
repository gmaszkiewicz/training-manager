---
import Layout from "@/layouts/Layout.astro";
import HomeActions from "@/components/home/HomeActions";
import Topbar from "@/components/Topbar.astro";
import { Button } from "@/components/ui/button";
---

<Layout title="Kitchen sink — home">
  <div class="bg-background text-foreground w-full flex-1">
    <div class="mx-auto flex max-w-4xl flex-col gap-12 px-4 py-10 sm:px-8">
      <header class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold">Kitchen sink — product home</h1>
        <p class="text-muted-foreground text-sm">
          States for <code class="text-foreground">/</code>. Signed-out composition only (does not read session).
        </p>
      </header>

      <section class="flex flex-col gap-4" aria-labelledby="state-topbar">
        <h2 id="state-topbar" class="border-border border-b pb-2 text-lg font-semibold">
          Topbar
        </h2>
        <p class="text-muted-foreground text-sm">
          Preview bars for the eleven product outcomes. Each uses <code class="text-foreground">Topbar</code> with{" "}
          <code class="text-foreground">preview</code> so this sink stays session-free. Below the measurement-row width
          the links sit in a Menu button with the avatar to its right. At that width they stay in the bar before the
          avatar. The avatar opens Profile, Hub, Settings, and Sign out at every width. A signed-in bar always has a
          bell right before the avatar; it carries a badge only while something is unread.
        </p>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Guest on <code class="text-foreground">/</code>: "Hello, guest", Home marked.
          </p>
          <Topbar
            preview={{
              signedIn: false,
              email: "",
              role: null,
              firstName: null,
              lastName: null,
              avatarUrl: null,
              pathname: "/",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Guest on <code class="text-foreground">/auth/signin</code>: Sign in marked.
          </p>
          <Topbar
            preview={{
              signedIn: false,
              email: "",
              role: null,
              firstName: null,
              lastName: null,
              avatarUrl: null,
              pathname: "/auth/signin",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee <code class="text-foreground">ada@example.com</code> named Ada Lovelace on{" "}
            <code class="text-foreground">/</code>: "Hello, A. Lovelace", Home marked, Home and Measurements links,
            avatar "AL" opening Profile, Hub, Settings, Sign out.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: null,
              pathname: "/",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainer <code class="text-foreground">ada@example.com</code> with no saved name on{" "}
            <code class="text-foreground">/measurements</code>: "Hello, ada@example.com", Measurements marked, href{" "}
            <code class="text-foreground">/measurements</code>, avatar "A" from the email. This is the bar for{" "}
            <code class="text-foreground">/measurements?trainee=abc</code>.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainer",
              firstName: null,
              lastName: null,
              avatarUrl: null,
              pathname: "/measurements",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Signed in, role null, email <code class="text-foreground">ada@example.com</code>, pathname{" "}
            <code class="text-foreground">/measurements</code>: the email only, Measurements marked, no Hello line.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: null,
              firstName: null,
              lastName: null,
              avatarUrl: null,
              pathname: "/measurements",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee Ada Lovelace on <code class="text-foreground">/profile</code>: no bar link marked; Profile is marked
            inside the avatar menu.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: null,
              pathname: "/profile",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee with no saved name on <code class="text-foreground">/settings</code>: avatar "A" from the email;
            Settings is marked inside the avatar menu.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: null,
              lastName: null,
              avatarUrl: null,
              pathname: "/settings",
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee Ada Lovelace with a saved avatar on <code class="text-foreground">/profile/avatar</code>: the avatar
            shows the image instead of "AL"; Profile is marked inside the avatar menu.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: "/kitchen-sink/avatar.png",
              pathname: "/profile/avatar",
            }}
          />
        </div>
        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee Ada Lovelace on <code class="text-foreground">/</code> with no unread notifications: the bell has no
            badge, and its menu holds only "See all notifications".
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: null,
              pathname: "/",
              notifications: { unreadCount: 0, latest: [] },
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainee Ada Lovelace on <code class="text-foreground">/</code> with 3 unread: the bell sits before the
            avatar with badge "3"; it lists "Trainer G. Hopper requested read access to your measurements", "Trainee A.
            Turing gave you read access to their measurements", "Trainee edsger@example.com revoked your read access to
            their measurements" and "See all notifications".
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainee",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: null,
              pathname: "/",
              notifications: {
                unreadCount: 3,
                latest: [
                  {
                    id: "00000000-0000-4000-8000-000000000001",
                    kind: "link_requested",
                    actorRole: "trainer",
                    actorFirstName: "Grace",
                    actorLastName: "Hopper",
                    actorEmail: "grace@example.com",
                    createdAt: "2026-10-27T09:30:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000002",
                    kind: "link_accepted",
                    actorRole: "trainee",
                    actorFirstName: "Alan",
                    actorLastName: "Turing",
                    actorEmail: "alan@example.com",
                    createdAt: "2026-10-26T09:31:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000003",
                    kind: "link_removed",
                    actorRole: "trainee",
                    actorFirstName: null,
                    actorLastName: null,
                    actorEmail: "edsger@example.com",
                    createdAt: "2026-10-25T09:32:00.000Z",
                    readAt: null,
                  },
                ],
              },
            }}
          />
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-muted-foreground text-sm">
            Trainer Ada Lovelace on <code class="text-foreground">/</code> with 120 unread: badge "99+", the label still
            reads 120; the menu lists the latest five.
          </p>
          <Topbar
            preview={{
              signedIn: true,
              email: "ada@example.com",
              role: "trainer",
              firstName: "Ada",
              lastName: "Lovelace",
              avatarUrl: null,
              pathname: "/",
              notifications: {
                unreadCount: 120,
                latest: [
                  {
                    id: "00000000-0000-4000-8000-000000000001",
                    kind: "link_requested",
                    actorRole: "trainer",
                    actorFirstName: "Grace",
                    actorLastName: "Hopper",
                    actorEmail: "grace@example.com",
                    createdAt: "2026-10-27T09:30:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000002",
                    kind: "link_accepted",
                    actorRole: "trainee",
                    actorFirstName: "Alan",
                    actorLastName: "Turing",
                    actorEmail: "alan@example.com",
                    createdAt: "2026-10-26T09:31:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000003",
                    kind: "link_removed",
                    actorRole: "trainee",
                    actorFirstName: null,
                    actorLastName: null,
                    actorEmail: "edsger@example.com",
                    createdAt: "2026-10-25T09:32:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000004",
                    kind: "link_requested",
                    actorRole: "trainer",
                    actorFirstName: "Grace",
                    actorLastName: "Hopper",
                    actorEmail: "grace@example.com",
                    createdAt: "2026-10-24T09:33:00.000Z",
                    readAt: null,
                  },
                  {
                    id: "00000000-0000-4000-8000-000000000005",
                    kind: "link_accepted",
                    actorRole: "trainee",
                    actorFirstName: "Alan",
                    actorLastName: "Turing",
                    actorEmail: "alan@example.com",
                    createdAt: "2026-10-23T09:34:00.000Z",
                    readAt: null,
                  },
                ],
              },
            }}
          />
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-default">
        <h2 id="state-default" class="border-border border-b pb-2 text-lg font-semibold">
          Default
        </h2>
        <p class="text-muted-foreground text-sm">
          Signed-out home: heading, paragraph, and HomeActions with signedIn false.
        </p>
        <div class="mx-auto flex w-full max-w-4xl flex-col items-center justify-center px-4 py-16 text-center">
          <h1 class="mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">Training Manager</h1>
          <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
            A trainee records body measurements and sees the up/down difference versus the previous entry. A trainer who
            linked that trainee can preview that list.
          </p>
          <div class="flex flex-col gap-4 sm:flex-row">
            <HomeActions client:load signedIn={false} />
          </div>
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-hover">
        <h2 id="state-hover" class="border-border border-b pb-2 text-lg font-semibold">
          Hover
        </h2>
        <p class="text-muted-foreground text-sm">
          Hover comes from Button: default uses <code class="text-foreground">hover:bg-primary/90</code>; outline uses
          <code class="text-foreground">hover:bg-accent hover:text-accent-foreground</code>.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <Button client:load variant="default">
            Sign in
          </Button>
          <Button client:load variant="outline">
            Sign up
          </Button>
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-focus-visible">
        <h2 id="state-focus-visible" class="border-border border-b pb-2 text-lg font-semibold">
          Focus-visible
        </h2>
        <p class="text-muted-foreground text-sm">
          The ring comes from Button's focus-visible treatment: border-ring, ring-ring/50, and a three-pixel ring. Tab
          to the control below to see it.
        </p>
        <div>
          <Button client:load variant="default">
            Sign in
          </Button>
        </div>
      </section>

      <section class="flex flex-col gap-4" aria-labelledby="state-na">
        <h2 id="state-na" class="border-border border-b pb-2 text-lg font-semibold">
          N/A
        </h2>
        <ul class="text-muted-foreground list-disc space-y-2 pl-5 text-sm">
          <li>
            <span class="text-foreground font-medium">disabled</span> — no control on{" "}
            <code class="text-foreground">/</code> is disabled
          </li>
          <li>
            <span class="text-foreground font-medium">error</span> — <code class="text-foreground">/</code> has no field
            and no failing action; the layout config banner is unchanged and out of scope
          </li>
          <li>
            <span class="text-foreground font-medium">empty</span> — <code class="text-foreground">/</code> has no list;
            the explanation is always present
          </li>
          <li>
            <span class="text-foreground font-medium">loading</span> — the session is resolved before HTML; this view
            does not fetch
          </li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
