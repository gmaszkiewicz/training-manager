---
import Layout from "@/layouts/Layout.astro";
import ChangePasswordForm from "@/components/auth/ChangePasswordForm";
import Topbar from "@/components/Topbar.astro";
import { PASSWORD_CHANGED_NOTICE, profilePageError } from "@/lib/auth-reset";

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const serverError = profilePageError(error);
---

<Layout title="Profile" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4 text-card-foreground">
      <div class="mx-auto max-w-sm">
        <h1 class="mb-2 text-center text-xl font-bold text-foreground">Profile</h1>
        <h2 class="mb-6 text-center text-lg font-semibold text-card-foreground">Change password</h2>
        <ChangePasswordForm
          serverError={serverError}
          notice={notice === "password-changed" ? PASSWORD_CHANGED_NOTICE : null}
          client:load
        />
      </div>
    </div>
  </div>
</Layout>
