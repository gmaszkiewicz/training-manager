---
import Layout from "@/layouts/Layout.astro";
import AccountTabs from "@/components/account/AccountTabs";
import ProfileDetailsForm from "@/components/profile/ProfileDetailsForm";
import Topbar from "@/components/Topbar.astro";
import { PROFILE_SAVED_NOTICE, PROFILE_UNAVAILABLE_ERROR, profilePageError } from "@/lib/profile-form";
import { readProfileNames } from "@/lib/services/profile-details";
import { createClient } from "@/lib/supabase";
import type { ProfileDetails } from "@/types";

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const user = Astro.locals.user;
const details: ProfileDetails = { email: user?.email ?? "", firstName: null, lastName: null };
let unavailable = false;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  const names = supabase ? await readProfileNames(supabase, user.id) : null;
  if (names) {
    details.firstName = names.firstName;
    details.lastName = names.lastName;
  } else {
    // Blank fields here would look like the saved state, and Save would wipe the stored names.
    unavailable = true;
  }
}
const serverError = profilePageError(error) ?? (unavailable ? PROFILE_UNAVAILABLE_ERROR : null);
---

<Layout title="Profile" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4 text-card-foreground">
      <AccountTabs tab={{ value: "details", label: "Details" }}>
        <ProfileDetailsForm
          email={details.email}
          firstName={details.firstName}
          lastName={details.lastName}
          serverError={serverError}
          unavailable={unavailable}
          notice={notice === "profile-saved" ? PROFILE_SAVED_NOTICE : null}
          client:load
        />
      </AccountTabs>
    </div>
  </div>
</Layout>
