---
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import MeasurementList from "@/components/measurements/MeasurementList.astro";
import Layout from "@/layouts/Layout.astro";
import { ensureProfile } from "@/lib/services/ensure-profile";
import { listMeasurements } from "@/lib/services/measurements";
import { listTrainerLinks } from "@/lib/services/trainer-links";
import { createClient } from "@/lib/supabase";
import { selectTrainerPreview, type TrainerLink } from "@/lib/trainer-preview";
import type { MeasurementWithDeltas, Profile } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");
const traineeParam = Astro.url.searchParams.get("trainee");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];
let trainerLinks: TrainerLink[] = [];
let selectedLink: TrainerLink | null = null;
let trainerLinksLoaded = false;
let trainerMeasurementsLoaded = false;

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    if (ensured.ok) {
      role = ensured.role;
      if (role === "trainee") {
        const listed = await listMeasurements(supabase, user.id);
        measurementsLoaded = listed.ok;
        if (listed.ok) {
          entries = listed.entries;
        }
      } else {
        const listedLinks = await listTrainerLinks(supabase);
        trainerLinksLoaded = listedLinks.ok;
        if (listedLinks.ok) {
          const preview = selectTrainerPreview(listedLinks.links, traineeParam);
          trainerLinks = preview.links;
          selectedLink = preview.selected;
          if (selectedLink) {
            const listed = await listMeasurements(supabase, selectedLink.traineeId);
            trainerMeasurementsLoaded = listed.ok;
            if (listed.ok) {
              entries = listed.entries;
            }
          }
        }
      }
    }
  }
}
---

<Layout title="Dashboard">
  {role === "trainee" ? (
    <TraineeJournal
      email={user?.email}
      measurementsLoaded={measurementsLoaded}
      entries={entries}
      serverError={serverError}
    />
  ) : (
    <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
      <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          {role === "trainer" ? "Trainer" : "Dashboard"}
        </h1>
        {role === "trainer" ? (
          <>
            <p class="text-blue-100/80">
              Welcome, <span class="font-semibold text-white">{user?.email}</span>
            </p>
            {serverError ? <p class="mt-2 text-sm text-blue-100/80">{serverError}</p> : null}
            {trainerLinksLoaded ? (
              <>
                <form method="POST" action="/api/trainer-links" class="mt-6 space-y-3 text-left">
                  {selectedLink ? <input type="hidden" name="trainee" value={selectedLink.traineeId} /> : null}
                  <label for="email" class="mb-1 block text-sm text-blue-100/80">
                    Email
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-purple-400"
                  />
                  <button
                    type="submit"
                    class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
                  >
                    Link trainee
                  </button>
                </form>
                {trainerLinks.length > 0 ? (
                  <>
                    <ul class="mt-6 space-y-2 text-left text-sm">
                      {trainerLinks.map((link) => (
                        <li>
                          <a
                            href={`/dashboard?trainee=${encodeURIComponent(link.traineeId)}`}
                            aria-current={selectedLink?.traineeId === link.traineeId ? "page" : undefined}
                            class:list={[
                              "text-blue-100/80 hover:underline",
                              selectedLink?.traineeId === link.traineeId && "font-semibold text-white",
                            ]}
                          >
                            {link.email}
                          </a>
                        </li>
                      ))}
                    </ul>
                    {selectedLink ? (
                      trainerMeasurementsLoaded ? (
                        entries.length === 0 ? (
                          <p class="mt-6 text-sm text-blue-100/50">No measurements yet</p>
                        ) : (
                          <MeasurementList entries={entries} />
                        )
                      ) : (
                        <p class="mt-6 text-sm text-blue-100/80">Could not load measurements</p>
                      )
                    ) : null}
                  </>
                ) : null}
              </>
            ) : (
              <p class="mt-2 text-sm text-blue-100/80">Could not load trainees</p>
            )}
          </>
        ) : (
          <p class="text-blue-100/80">Could not open your journal</p>
        )}
        <form method="POST" action="/api/auth/signout" class="mt-6">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  )}
</Layout>
