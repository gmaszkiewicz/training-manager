---
import MeasurementForm from "@/components/measurements/MeasurementForm";
import MeasurementList from "@/components/measurements/MeasurementList.astro";
import Layout from "@/layouts/Layout.astro";
import { ensureProfile } from "@/lib/services/ensure-profile";
import { listMeasurements } from "@/lib/services/measurements";
import { createClient } from "@/lib/supabase";
import type { MeasurementWithDeltas, Profile } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    if (ensured.ok) {
      role = ensured.role;
      if (role === "trainee") {
        const listed = await listMeasurements(supabase, user.id);
        measurementsLoaded = listed.ok;
        if (listed.ok) {
          entries = listed.entries;
        }
      }
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {role === "trainee" ? "Journal" : role === "trainer" ? "Trainer" : "Dashboard"}
      </h1>
      {role === "trainee" ? (
        <>
          <p class="text-blue-100/80">
            Welcome, <span class="font-semibold text-white">{user?.email}</span>
          </p>
          {measurementsLoaded ? (
            <>
              <div class="mt-6">
                <MeasurementForm serverError={serverError} client:load />
              </div>
              {entries.length === 0 ? (
                <p class="mt-6 text-sm text-blue-100/50">No measurements yet</p>
              ) : (
                <MeasurementList entries={entries} />
              )}
            </>
          ) : (
            <p class="mt-2 text-sm text-blue-100/80">Could not load your measurements</p>
          )}
        </>
      ) : role === "trainer" ? (
        <p class="text-blue-100/80">
          Welcome, <span class="font-semibold text-white">{user?.email}</span>
        </p>
      ) : (
        <p class="text-blue-100/80">Could not open your journal</p>
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
