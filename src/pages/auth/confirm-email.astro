---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
---

<Layout title="Check your email" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-[74rem]">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-[74rem] min-w-0 rounded-xl border p-4 text-center text-card-foreground">
      <div class="mx-auto max-w-sm">
        <h1 class="mb-3 text-xl font-bold text-foreground">Check your email</h1>
        <p class="text-muted-foreground mb-6 text-sm">
          We've sent a confirmation link to your email address. Click it to activate your account.
        </p>
        <a
          href="/auth/signin"
          class="text-primary focus-visible:ring-ring text-sm hover:underline focus-visible:ring-2"
        >
          Back to sign in
        </a>
      </div>
    </div>
  </div>
</Layout>
