---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import ResetPasswordHashError from "@/components/auth/ResetPasswordHashError";
import ResetPasswordRequestForm from "@/components/auth/ResetPasswordRequestForm";
import Topbar from "@/components/Topbar.astro";
import { RESET_SENT_NOTICE, resetPageError } from "@/lib/auth-reset";

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const tokenHash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type");
const showNewPassword = Boolean(tokenHash) && type === "recovery" && error !== "reset-link";
const serverError = resetPageError(error);
---

<Layout title="Reset password">
  <div class="flex min-h-screen flex-col p-4 sm:p-8">
    <Topbar />
    <div class="flex flex-1 items-center justify-center">
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
        <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">Reset password</h1>
        <ResetPasswordHashError client:load />
        {notice === "reset-sent" ? (
          <p class="mb-4 text-center text-sm text-muted-foreground">{RESET_SENT_NOTICE}</p>
        ) : null}
        {showNewPassword ? (
          <ResetPasswordForm tokenHash={tokenHash ?? ""} serverError={serverError} client:load />
        ) : (
          <ResetPasswordRequestForm serverError={serverError} client:load />
        )}
      </div>
    </div>
  </div>
</Layout>
