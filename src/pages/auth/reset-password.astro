---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import ResetPasswordHashError from "@/components/auth/ResetPasswordHashError";
import ResetPasswordRequestForm from "@/components/auth/ResetPasswordRequestForm";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import {
  isRecoveryAccessToken,
  positiveSeconds,
  RESET_SENT_NOTICE,
  resetLimitError,
  resetPageError,
} from "@/lib/auth-reset";

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const tokenHash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type");
const supabase = createClient(Astro.request.headers, Astro.cookies);
const session = supabase ? (await supabase.auth.getSession()).data.session : null;
const recoverySession = session ? isRecoveryAccessToken(session.access_token) : false;
const hasToken = Boolean(tokenHash) && type === "recovery" && error !== "reset-link";
const retryError = error === "password-same" || error === "password-short" || error === "password-mismatch";
const recoveryHandoff = Astro.url.searchParams.get("recovery") === "1";
const showNewPassword = hasToken || (recoverySession && (retryError || recoveryHandoff));
const serverError =
  error === "reset-limit"
    ? resetLimitError(positiveSeconds(Astro.url.searchParams.get("wait")))
    : resetPageError(error);
---

<Layout title="Reset password" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4 text-card-foreground">
      <div class="mx-auto max-w-sm">
        <h1 class="mb-6 text-center text-xl font-bold text-foreground">Reset password</h1>
        <p id="recovery-handoff" class="text-muted-foreground mb-4 text-center text-sm" style="display: none">
          Opening your reset link...
        </p>
        <ResetPasswordHashError client:load />
        <div id="reset-choice">
          {notice === "reset-sent" ? (
            <p class="text-muted-foreground mb-4 text-center text-sm">{RESET_SENT_NOTICE}</p>
          ) : null}
          {showNewPassword ? (
            <ResetPasswordForm tokenHash={tokenHash ?? ""} serverError={serverError} client:load />
          ) : (
            <ResetPasswordRequestForm serverError={serverError} client:load />
          )}
        </div>
        <script is:inline>
          if (location.hash.includes("access_token=") && location.hash.includes("type=recovery")) {
            const choice = document.getElementById("reset-choice");
            const handoff = document.getElementById("recovery-handoff");
            if (choice) choice.style.display = "none";
            if (handoff) handoff.style.display = "block";
          }
        </script>
      </div>
    </div>
  </div>
</Layout>
