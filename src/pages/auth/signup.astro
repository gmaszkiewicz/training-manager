---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import Topbar from "@/components/Topbar.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex min-h-screen flex-col p-4 sm:p-8">
    <Topbar />
    <div class="flex flex-1 items-center justify-center">
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
        <h1 class="mb-6 text-center text-2xl font-bold text-card-foreground">Sign up</h1>
        <SignUpForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-muted-foreground">
          Already have an account?{" "}
          <a href="/auth/signin" class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-ring">
            Sign in
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
