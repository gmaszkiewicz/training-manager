---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import Topbar from "@/components/Topbar.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4 text-card-foreground">
      <div class="mx-auto max-w-sm">
        <h1 class="mb-6 text-center text-xl font-bold text-foreground">Sign up</h1>
        <SignUpForm serverError={error} client:load />
        <p class="text-muted-foreground mt-4 text-center text-sm">
          Already have an account?{" "}
          <a href="/auth/signin" class="text-primary focus-visible:ring-ring hover:underline focus-visible:ring-2">
            Sign in
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
