---
import Layout from "@/layouts/Layout.astro";
import AccountTabs from "@/components/account/AccountTabs";
import ChangePasswordForm from "@/components/auth/ChangePasswordForm";
import Topbar from "@/components/Topbar.astro";
import { PASSWORD_CHANGED_NOTICE, settingsPageError } from "@/lib/auth-reset";

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const serverError = settingsPageError(error);
---

<Layout title="Settings" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  <div class="flex justify-center px-4 pb-4">
    <div class="border-border bg-card w-full max-w-measurement min-w-0 rounded-xl border p-4 text-card-foreground">
      <AccountTabs tab={{ value: "change-password", label: "Change password" }}>
        <ChangePasswordForm
          serverError={serverError}
          notice={notice === "password-changed" ? PASSWORD_CHANGED_NOTICE : null}
          client:load
        />
      </AccountTabs>
    </div>
  </div>
</Layout>
