---
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import TrainerPanel from "@/components/trainer/TrainerPanel.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import {
  addFormStorageKey,
  chartsOpenStorageKey,
  chartsPeriodStorageKey,
  dayStorageKey,
  parseAddFormOpen,
  parseChartsOpen,
  defaultPageSize,
  journalMonth,
  journalPageStorageKey,
  listOpenStorageKey,
  parseJournalPage,
  parseListOpen,
  parseTraineePickerOpen,
  traineePickerOpenStorageKey,
  measurementMonth,
  pageSizeStorageKey,
  selectedTraineeStorageKey,
  parsePageSize,
  parseTopChartsFields,
  topChartsFieldsStorageKey,
  topChartsOpenStorageKey,
  topChartsPeriodStorageKey,
  utcToday,
  type PageSize,
} from "@/lib/measurement-page";
import { requestedNoticeEmail } from "@/lib/collaborations";
import { componentTiles, isModuleOn } from "@/lib/components";
import { ensureProfile } from "@/lib/services/ensure-profile";
import type { ChartBody } from "@/types";
import {
  chartWindow,
  defaultChartPeriod,
  lastYearsRange,
  monthAnchor,
  parseChartPreference,
  type ChartPreference,
  type ChartPeriod,
} from "@/lib/measurement-chart";
import {
  getMeasurement,
  readMeasurementDays,
  readMeasurementPage,
  readMeasurementRange,
  readPreviousMeasurement,
} from "@/lib/services/measurements";
import { listTrainerLinks } from "@/lib/services/trainer-links";
import { createClient } from "@/lib/supabase";
import { latestMeasuredOnBound } from "@/lib/measurement-input";
import { measurementNoticeMessage } from "@/lib/measurement-notice";
import { measurementValues } from "@/lib/measurement-previous";
import { circumferenceFields } from "@/lib/measurement-top-changes";
import { preferredTraineeId, selectTrainerPreview, type TrainerLink } from "@/lib/trainer-preview";
import type {
  CircumferenceField,
  ComponentTiles,
  MeasurementEntry,
  MeasurementField,
  MeasurementWithDeltas,
  Profile,
} from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");
const measurementNotice = measurementNoticeMessage(
  Astro.url.searchParams.get("notice"),
  Astro.url.searchParams.get("measured_on"),
);
const traineeParam = Astro.url.searchParams.get("trainee");
const requestedParam = Astro.url.searchParams.get("requested");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let traineeAccountId: string | undefined;
let trainerAccountId: string | undefined;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];
let editingEntry: MeasurementEntry | null = null;
let confirmingEntry: MeasurementEntry | null = null;
let previousEntry: Pick<MeasurementEntry, MeasurementField> | null = null;
let dates: string[] = [];
let page = 1;
let pageCount = 1;
let pageSize: PageSize = defaultPageSize;
let traineeServerError = serverError;
let trainerLinks: TrainerLink[] = [];
let selectedLink: TrainerLink | null = null;
let trainerLinksLoaded = false;
let trainerMeasurementsLoaded = false;
let requestedEmail: string | null = null;
let chartsPeriod: ChartPeriod = defaultChartPeriod;
let chartsAnchor: string | null = null;
let chartInitial: ChartBody | null = null;
let chartDays: string[] | null = null;
let topChartsPeriod: ChartPeriod = defaultChartPeriod;
let topChartsAnchor: string | null = null;
let topChartInitial: ChartBody | null = null;
let topChartsFields: CircumferenceField[] = [...circumferenceFields];
let tiles: ComponentTiles = {};
const now = new Date();
const today = utcToday(now);
let month = measurementMonth(today);

function cookieValue(name: string): string | null {
  return Astro.cookies.get(name)?.value ?? null;
}

function preferredPageSize(accountUserId: string): PageSize {
  return parsePageSize(cookieValue(pageSizeStorageKey(accountUserId)));
}

function preferredMonth(accountUserId: string, subjectTraineeId: string): string {
  return journalMonth(cookieValue(dayStorageKey(accountUserId, subjectTraineeId))) ?? measurementMonth(today);
}

function preferredJournalPage(accountUserId: string, subjectTraineeId: string): number {
  return parseJournalPage(cookieValue(journalPageStorageKey(accountUserId, subjectTraineeId)));
}

function preferredAddForm(accountUserId: string): boolean | null {
  return parseAddFormOpen(cookieValue(addFormStorageKey(accountUserId)));
}

function preferredListOpen(accountUserId: string): boolean | null {
  return parseListOpen(cookieValue(listOpenStorageKey(accountUserId)));
}

function preferredTraineePickerOpen(accountUserId: string): boolean | null {
  return parseTraineePickerOpen(cookieValue(traineePickerOpenStorageKey(accountUserId)));
}

function preferredChartsOpen(accountUserId: string): boolean | null {
  return parseChartsOpen(cookieValue(chartsOpenStorageKey(accountUserId)));
}

function preferredChartsPeriod(accountUserId: string, subjectTraineeId: string): ChartPreference {
  return parseChartPreference(cookieValue(chartsPeriodStorageKey(accountUserId, subjectTraineeId)));
}

function preferredTopChartsOpen(accountUserId: string): boolean | null {
  return parseChartsOpen(cookieValue(topChartsOpenStorageKey(accountUserId)));
}

function preferredTopChartsPeriod(accountUserId: string, subjectTraineeId: string): ChartPreference {
  return parseChartPreference(cookieValue(topChartsPeriodStorageKey(accountUserId, subjectTraineeId)));
}

function preferredTopChartsFields(accountUserId: string, subjectTraineeId: string): CircumferenceField[] {
  return parseTopChartsFields(cookieValue(topChartsFieldsStorageKey(accountUserId, subjectTraineeId)));
}

type MeasurementDaysRead = ReturnType<typeof readMeasurementDays>;
type MeasurementRangeRead = ReturnType<typeof readMeasurementRange>;

function readChartRange(
  client: NonNullable<typeof supabase>,
  subjectTraineeId: string,
  period: ChartPeriod,
  anchor: string,
): MeasurementRangeRead {
  return readMeasurementRange(client, subjectTraineeId, { period, anchor, years: lastYearsRange(today) });
}

/** Both reads cover the same entries when the two periods resolve to the same window. */
function sameChartWindow(period: ChartPeriod, anchor: string, otherPeriod: ChartPeriod, otherAnchor: string): boolean {
  if (period !== otherPeriod) {
    return false;
  }
  const years = lastYearsRange(today);
  const window = chartWindow(period, anchor, years);
  const other = chartWindow(otherPeriod, otherAnchor, years);
  return window.start === other.start && window.end === other.end;
}

// The Charts tile's first render: its remembered period's range, plus the days for its picker. A failed read leaves
// both to the island's own fetch. Without the Charts tile only the days are read (the Top progression picker).
async function readInitialChart(rangeRead: MeasurementRangeRead | null, daysRead: MeasurementDaysRead): Promise<void> {
  const [range, days] = await Promise.all([rangeRead, daysRead]);
  chartInitial = range?.ok ? { entries: range.entries, window: range.window } : null;
  chartDays = days.ok ? days.days : null;
}

// The Top progression tile's first render: its own remembered period's range. Its picker shares the Charts tile's days.
async function readInitialTopChart(rangeRead: MeasurementRangeRead): Promise<void> {
  const range = await rangeRead;
  topChartInitial = range.ok ? { entries: range.entries, window: range.window } : null;
}

// The shown chart tiles' first render around the list's month. The days read starts with the list, so only the range
// reads wait for the list's month; when both tiles name the same window they share one range read. A tile that is off
// skips its range read.
async function readInitialCharts(
  client: NonNullable<typeof supabase>,
  accountUserId: string,
  subjectTraineeId: string,
  listMonth: string,
  daysRead: MeasurementDaysRead,
  shownCharts: { charts: boolean; topCharts: boolean },
): Promise<void> {
  // The charts keep their own week, month or year apart from the list; only a first visit starts from its month.
  const firstAnchor = monthAnchor(listMonth, today);
  const preference = preferredChartsPeriod(accountUserId, subjectTraineeId);
  chartsPeriod = preference.period;
  chartsAnchor = preference.anchor ?? firstAnchor;
  const topPreference = preferredTopChartsPeriod(accountUserId, subjectTraineeId);
  topChartsPeriod = topPreference.period;
  topChartsAnchor = topPreference.anchor ?? firstAnchor;
  topChartsFields = preferredTopChartsFields(accountUserId, subjectTraineeId);
  const rangeRead = shownCharts.charts ? readChartRange(client, subjectTraineeId, chartsPeriod, chartsAnchor) : null;
  let topRangeRead: MeasurementRangeRead | null = null;
  if (shownCharts.topCharts) {
    topRangeRead =
      rangeRead !== null && sameChartWindow(chartsPeriod, chartsAnchor, topChartsPeriod, topChartsAnchor)
        ? rangeRead
        : readChartRange(client, subjectTraineeId, topChartsPeriod, topChartsAnchor);
  }
  await Promise.all([
    readInitialChart(rangeRead, daysRead),
    topRangeRead !== null ? readInitialTopChart(topRangeRead) : null,
  ]);
}

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    // The signed-in user's own choices: with the module off the page sends them to Hub (also the sign-in landing).
    if (ensured.ok && !isModuleOn(ensured.components, "measurements")) {
      return Astro.redirect("/hub", 302);
    }
    if (ensured.ok) {
      role = ensured.role;
      const shownTiles = componentTiles(ensured.components);
      tiles = shownTiles;
      const shownCharts = { charts: shownTiles.progression.shown, topCharts: shownTiles["top-changes"].shown };
      const chartsShown = shownCharts.charts || shownCharts.topCharts;
      if (role === "trainee") {
        traineeAccountId = user.id;
        const listShown = shownTiles.measurements.shown;
        // With Edit measurement off `?edit=` falls back to the normal view; the delete prompt lives in the list.
        const editId = shownTiles["edit-measurement"].shown ? Astro.url.searchParams.get("edit") : null;
        const deleteId = listShown ? Astro.url.searchParams.get("delete") : null;
        // The charts start from the list's month, so the list is read whenever the list, a chart or the Edit card shows.
        const listNeeded = listShown || chartsShown || editId !== null;
        // The reads are independent, so they start together; their results apply in the order below.
        const listedRead = listNeeded
          ? readMeasurementPage(supabase, user.id, {
              month: preferredMonth(user.id, user.id),
              page: preferredJournalPage(user.id, user.id),
              pageSize: preferredPageSize(user.id),
              focusId: deleteId ?? editId,
              now,
            })
          : null;
        const daysRead = editId === null && chartsShown ? readMeasurementDays(supabase, user.id) : null;
        // The add form starts from the trainee's latest entry; a failed read leaves the fields empty.
        // measured_on is the trainee's wall clock, so the bound sits past the latest minute any zone can save.
        const previousRead =
          editId === null && shownTiles["new-measurement"].shown
            ? readPreviousMeasurement(supabase, user.id, latestMeasuredOnBound(now))
            : null;
        const editRead = editId !== null ? getMeasurement(supabase, user.id, editId) : null;
        const deleteRead = deleteId !== null ? getMeasurement(supabase, user.id, deleteId) : null;
        // Nothing to load when no tile needs the list.
        const listed = listedRead !== null ? await listedRead : null;
        measurementsLoaded = listed === null || listed.ok;
        if (listed?.ok) {
          entries = listed.entries;
          dates = listed.dates;
          page = listed.page;
          pageCount = listed.pageCount;
          pageSize = listed.pageSize;
          month = listed.month;
        }
        if (listed?.ok && daysRead !== null) {
          await readInitialCharts(supabase, user.id, user.id, month, daysRead, shownCharts);
        } else if (daysRead !== null) {
          // Without the list there is no chart, so the days are discarded.
          await daysRead;
        }
        if (previousRead !== null) {
          const read = await previousRead;
          if (read.ok && read.entry !== null) {
            previousEntry = measurementValues(read.entry);
          }
        }
        if (editRead !== null) {
          const loaded = await editRead;
          editingEntry = loaded.ok ? loaded.entry : null;
          if (editingEntry === null) {
            traineeServerError = serverError ?? "Could not open that measurement";
          }
        }
        if (deleteRead !== null) {
          const loaded = await deleteRead;
          confirmingEntry = loaded.ok ? loaded.entry : null;
          if (confirmingEntry === null) {
            traineeServerError = serverError ?? "Could not delete the measurement";
          }
        }
      } else {
        trainerAccountId = user.id;
        requestedEmail = requestedNoticeEmail(requestedParam);
        const listedLinks = await listTrainerLinks(supabase);
        trainerLinksLoaded = listedLinks.ok;
        if (listedLinks.ok) {
          const rememberedTrainee = cookieValue(selectedTraineeStorageKey(user.id));
          const requestedTrainee = preferredTraineeId(traineeParam, rememberedTrainee);
          const preview = selectTrainerPreview(listedLinks.links, requestedTrainee);
          trainerLinks = preview.links;
          selectedLink = preview.selected;
          if (selectedLink !== null && traineeParam === selectedLink.traineeId) {
            Astro.cookies.set(selectedTraineeStorageKey(user.id), selectedLink.traineeId, {
              path: "/",
              maxAge: 31536000,
              sameSite: "lax",
              httpOnly: true,
            });
          }
          // The charts start from the list's month, so the list is read whenever the list or a chart shows; with
          // the Measurements list off the charts still follow the selected (remembered or first linked) trainee.
          if (selectedLink && !shownTiles["trainee-measurements"].shown && !chartsShown) {
            trainerMeasurementsLoaded = true;
          } else if (selectedLink) {
            const daysRead = chartsShown ? readMeasurementDays(supabase, selectedLink.traineeId) : null;
            const listed = await readMeasurementPage(supabase, selectedLink.traineeId, {
              month: preferredMonth(user.id, selectedLink.traineeId),
              page: preferredJournalPage(user.id, selectedLink.traineeId),
              pageSize: preferredPageSize(user.id),
              focusId: null,
              now,
            });
            trainerMeasurementsLoaded = listed.ok;
            if (listed.ok) {
              entries = listed.entries;
              dates = listed.dates;
              page = listed.page;
              pageCount = listed.pageCount;
              pageSize = listed.pageSize;
              month = listed.month;
              if (daysRead !== null) {
                await readInitialCharts(supabase, user.id, selectedLink.traineeId, month, daysRead, shownCharts);
              }
            } else if (daysRead !== null) {
              // Without the list there is no chart, so the days are discarded.
              await daysRead;
            }
          }
        }
      }
    }
  }
}
---

<Layout title="Measurements" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  {role === "trainee" ? (
    <TraineeJournal
      measurementsLoaded={measurementsLoaded}
      entries={entries}
      serverError={traineeServerError}
      notice={measurementNotice}
      editingEntry={editingEntry}
      confirmingEntry={confirmingEntry}
      previousEntry={previousEntry}
      accountUserId={traineeAccountId}
      subjectTraineeId={traineeAccountId}
      addFormOpen={traineeAccountId ? preferredAddForm(traineeAccountId) : null}
      listOpen={traineeAccountId ? preferredListOpen(traineeAccountId) : null}
      chartsOpen={traineeAccountId ? preferredChartsOpen(traineeAccountId) : null}
      chartsPeriod={chartsPeriod}
      chartsAnchor={chartsAnchor}
      chartInitial={chartInitial}
      chartDays={chartDays}
      topChartsOpen={traineeAccountId ? preferredTopChartsOpen(traineeAccountId) : null}
      topChartsPeriod={topChartsPeriod}
      topChartsAnchor={topChartsAnchor}
      topChartInitial={topChartInitial}
      topChartsFields={topChartsFields}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
      shown={tiles}
    />
  ) : (
    <TrainerPanel
      mode={role === "trainer" ? "trainer" : "unavailable"}
      serverError={serverError}
      requestedEmail={requestedEmail}
      trainerLinksLoaded={trainerLinksLoaded}
      trainerLinks={trainerLinks}
      selectedLink={selectedLink}
      trainerMeasurementsLoaded={trainerMeasurementsLoaded}
      entries={entries}
      accountUserId={trainerAccountId}
      traineePickerOpen={trainerAccountId ? preferredTraineePickerOpen(trainerAccountId) : null}
      listOpen={trainerAccountId ? preferredListOpen(trainerAccountId) : null}
      chartsOpen={trainerAccountId ? preferredChartsOpen(trainerAccountId) : null}
      chartsPeriod={chartsPeriod}
      chartsAnchor={chartsAnchor}
      chartInitial={chartInitial}
      chartDays={chartDays}
      topChartsOpen={trainerAccountId ? preferredTopChartsOpen(trainerAccountId) : null}
      topChartsPeriod={topChartsPeriod}
      topChartsAnchor={topChartsAnchor}
      topChartInitial={topChartInitial}
      topChartsFields={topChartsFields}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
      shown={tiles}
    />
  )}
</Layout>
