---
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import TrainerPanel from "@/components/trainer/TrainerPanel.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { ensureProfile } from "@/lib/services/ensure-profile";
import { listMeasurements } from "@/lib/services/measurements";
import { listTrainerLinks } from "@/lib/services/trainer-links";
import { createClient } from "@/lib/supabase";
import { selectTrainerPreview, type TrainerLink } from "@/lib/trainer-preview";
import type { MeasurementWithDeltas, Profile } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");
const traineeParam = Astro.url.searchParams.get("trainee");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];
let trainerLinks: TrainerLink[] = [];
let selectedLink: TrainerLink | null = null;
let trainerLinksLoaded = false;
let trainerMeasurementsLoaded = false;

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    if (ensured.ok) {
      role = ensured.role;
      if (role === "trainee") {
        const listed = await listMeasurements(supabase, user.id);
        measurementsLoaded = listed.ok;
        if (listed.ok) {
          entries = listed.entries;
        }
      } else {
        const listedLinks = await listTrainerLinks(supabase);
        trainerLinksLoaded = listedLinks.ok;
        if (listedLinks.ok) {
          const preview = selectTrainerPreview(listedLinks.links, traineeParam);
          trainerLinks = preview.links;
          selectedLink = preview.selected;
          if (selectedLink) {
            const listed = await listMeasurements(supabase, selectedLink.traineeId);
            trainerMeasurementsLoaded = listed.ok;
            if (listed.ok) {
              entries = listed.entries;
            }
          }
        }
      }
    }
  }
}
---

<Layout title="Measurements">
  <div class="p-4 sm:p-8">
    <Topbar />
  </div>
  {role === "trainee" ? (
    <TraineeJournal measurementsLoaded={measurementsLoaded} entries={entries} serverError={serverError} />
  ) : (
    <TrainerPanel
      mode={role === "trainer" ? "trainer" : "unavailable"}
      serverError={serverError}
      trainerLinksLoaded={trainerLinksLoaded}
      trainerLinks={trainerLinks}
      selectedLink={selectedLink}
      trainerMeasurementsLoaded={trainerMeasurementsLoaded}
      entries={entries}
    />
  )}
</Layout>
