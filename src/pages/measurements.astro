---
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import TrainerPanel from "@/components/trainer/TrainerPanel.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import {
  dayStorageKey,
  defaultPageSize,
  journalMonth,
  measurementMonth,
  pageSizeStorageKey,
  parsePageSize,
  utcToday,
  type PageSize,
} from "@/lib/measurement-page";
import { ensureProfile } from "@/lib/services/ensure-profile";
import { getMeasurement, readMeasurementPage } from "@/lib/services/measurements";
import { listTrainerLinks } from "@/lib/services/trainer-links";
import { createClient } from "@/lib/supabase";
import { selectTrainerPreview, type TrainerLink } from "@/lib/trainer-preview";
import type { MeasurementEntry, MeasurementWithDeltas, Profile } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");
const traineeParam = Astro.url.searchParams.get("trainee");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let traineeAccountId: string | undefined;
let trainerAccountId: string | undefined;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];
let editingEntry: MeasurementEntry | null = null;
let confirmingEntry: MeasurementEntry | null = null;
let dates: string[] = [];
let page = 1;
let pageCount = 1;
let pageSize: PageSize = defaultPageSize;
let traineeServerError = serverError;
let trainerLinks: TrainerLink[] = [];
let selectedLink: TrainerLink | null = null;
let trainerLinksLoaded = false;
let trainerMeasurementsLoaded = false;
const now = new Date();
const today = utcToday(now);
let month = measurementMonth(today);

function cookieValue(name: string): string | null {
  return Astro.cookies.get(name)?.value ?? null;
}

function preferredPageSize(accountUserId: string): PageSize {
  return parsePageSize(cookieValue(pageSizeStorageKey(accountUserId)));
}

function preferredMonth(accountUserId: string, subjectTraineeId: string): string {
  return journalMonth(cookieValue(dayStorageKey(accountUserId, subjectTraineeId))) ?? measurementMonth(today);
}

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    if (ensured.ok) {
      role = ensured.role;
      if (role === "trainee") {
        traineeAccountId = user.id;
        const editId = Astro.url.searchParams.get("edit");
        const deleteId = Astro.url.searchParams.get("delete");
        const listed = await readMeasurementPage(supabase, user.id, {
          month: preferredMonth(user.id, user.id),
          page: 1,
          pageSize: preferredPageSize(user.id),
          focusId: deleteId ?? editId,
          now,
        });
        measurementsLoaded = listed.ok;
        if (listed.ok) {
          entries = listed.entries;
          dates = listed.dates;
          page = listed.page;
          pageCount = listed.pageCount;
          pageSize = listed.pageSize;
          month = listed.month;
        }
        if (editId !== null) {
          const loaded = await getMeasurement(supabase, user.id, editId);
          editingEntry = loaded.ok ? loaded.entry : null;
          if (editingEntry === null) {
            traineeServerError = serverError ?? "Could not open that measurement";
          }
        }
        if (deleteId !== null) {
          const loaded = await getMeasurement(supabase, user.id, deleteId);
          confirmingEntry = loaded.ok ? loaded.entry : null;
          if (confirmingEntry === null) {
            traineeServerError = serverError ?? "Could not delete the measurement";
          }
        }
      } else {
        trainerAccountId = user.id;
        const listedLinks = await listTrainerLinks(supabase);
        trainerLinksLoaded = listedLinks.ok;
        if (listedLinks.ok) {
          const preview = selectTrainerPreview(listedLinks.links, traineeParam);
          trainerLinks = preview.links;
          selectedLink = preview.selected;
          if (selectedLink) {
            const listed = await readMeasurementPage(supabase, selectedLink.traineeId, {
              month: preferredMonth(user.id, selectedLink.traineeId),
              page: 1,
              pageSize: preferredPageSize(user.id),
              focusId: null,
              now,
            });
            trainerMeasurementsLoaded = listed.ok;
            if (listed.ok) {
              entries = listed.entries;
              dates = listed.dates;
              page = listed.page;
              pageCount = listed.pageCount;
              pageSize = listed.pageSize;
              month = listed.month;
            }
          }
        }
      }
    }
  }
}
---

<Layout title="Measurements">
  <div class="p-4 sm:p-8">
    <Topbar />
  </div>
  {role === "trainee" ? (
    <TraineeJournal
      measurementsLoaded={measurementsLoaded}
      entries={entries}
      serverError={traineeServerError}
      editingEntry={editingEntry}
      confirmingEntry={confirmingEntry}
      accountUserId={traineeAccountId}
      subjectTraineeId={traineeAccountId}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
    />
  ) : (
    <TrainerPanel
      mode={role === "trainer" ? "trainer" : "unavailable"}
      serverError={serverError}
      trainerLinksLoaded={trainerLinksLoaded}
      trainerLinks={trainerLinks}
      selectedLink={selectedLink}
      trainerMeasurementsLoaded={trainerMeasurementsLoaded}
      entries={entries}
      accountUserId={trainerAccountId}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
    />
  )}
</Layout>
