---
import TraineeJournal from "@/components/journal/TraineeJournal.astro";
import TrainerPanel from "@/components/trainer/TrainerPanel.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import {
  addFormStorageKey,
  chartsOpenStorageKey,
  chartsPeriodStorageKey,
  dayStorageKey,
  parseAddFormOpen,
  parseChartsOpen,
  defaultPageSize,
  journalMonth,
  journalPageStorageKey,
  parseJournalPage,
  measurementMonth,
  pageSizeStorageKey,
  selectedTraineeStorageKey,
  parsePageSize,
  utcToday,
  type PageSize,
} from "@/lib/measurement-page";
import { requestedNoticeEmail } from "@/lib/collaborations";
import { ensureProfile } from "@/lib/services/ensure-profile";
import type { ChartBody } from "@/components/measurements/MeasurementCharts";
import {
  defaultChartPeriod,
  lastYearsRange,
  monthAnchor,
  parseChartPreference,
  type ChartPreference,
  type ChartPeriod,
} from "@/lib/measurement-chart";
import {
  getMeasurement,
  readMeasurementDays,
  readMeasurementPage,
  readMeasurementRange,
} from "@/lib/services/measurements";
import { listTrainerLinks } from "@/lib/services/trainer-links";
import { createClient } from "@/lib/supabase";
import { measurementNoticeMessage } from "@/lib/measurement-notice";
import { preferredTraineeId, selectTrainerPreview, type TrainerLink } from "@/lib/trainer-preview";
import type { MeasurementEntry, MeasurementWithDeltas, Profile } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const serverError = Astro.url.searchParams.get("error");
const measurementNotice = measurementNoticeMessage(
  Astro.url.searchParams.get("notice"),
  Astro.url.searchParams.get("measured_on"),
);
const traineeParam = Astro.url.searchParams.get("trainee");
const requestedParam = Astro.url.searchParams.get("requested");

type ProfileRole = Profile["role"];

function requestedRoleFromMetadata(metadata: { role?: unknown } | null | undefined): ProfileRole | null | "reject" {
  if (metadata != null && (metadata.role === "trainee" || metadata.role === "trainer")) {
    return metadata.role;
  }

  if (metadata == null || !("role" in metadata)) {
    return null;
  }

  return "reject";
}

let role: ProfileRole | null = null;
let traineeAccountId: string | undefined;
let trainerAccountId: string | undefined;
let measurementsLoaded = false;
let entries: MeasurementWithDeltas[] = [];
let editingEntry: MeasurementEntry | null = null;
let confirmingEntry: MeasurementEntry | null = null;
let dates: string[] = [];
let page = 1;
let pageCount = 1;
let pageSize: PageSize = defaultPageSize;
let traineeServerError = serverError;
let trainerLinks: TrainerLink[] = [];
let selectedLink: TrainerLink | null = null;
let trainerLinksLoaded = false;
let trainerMeasurementsLoaded = false;
let requestedEmail: string | null = null;
let chartsPeriod: ChartPeriod = defaultChartPeriod;
let chartsAnchor: string | null = null;
let chartInitial: ChartBody | null = null;
let chartDays: string[] | null = null;
const now = new Date();
const today = utcToday(now);
let month = measurementMonth(today);

function cookieValue(name: string): string | null {
  return Astro.cookies.get(name)?.value ?? null;
}

function preferredPageSize(accountUserId: string): PageSize {
  return parsePageSize(cookieValue(pageSizeStorageKey(accountUserId)));
}

function preferredMonth(accountUserId: string, subjectTraineeId: string): string {
  return journalMonth(cookieValue(dayStorageKey(accountUserId, subjectTraineeId))) ?? measurementMonth(today);
}

function preferredJournalPage(accountUserId: string, subjectTraineeId: string): number {
  return parseJournalPage(cookieValue(journalPageStorageKey(accountUserId, subjectTraineeId)));
}

function preferredAddForm(accountUserId: string): boolean | null {
  return parseAddFormOpen(cookieValue(addFormStorageKey(accountUserId)));
}

function preferredChartsOpen(accountUserId: string): boolean | null {
  return parseChartsOpen(cookieValue(chartsOpenStorageKey(accountUserId)));
}

function preferredChartsPeriod(accountUserId: string, subjectTraineeId: string): ChartPreference {
  return parseChartPreference(cookieValue(chartsPeriodStorageKey(accountUserId, subjectTraineeId)));
}

// The tile's first render: the remembered period around the list's month, plus the days for its picker. A failed
// read leaves both to the island's own fetch.
async function readInitialChart(
  client: NonNullable<typeof supabase>,
  accountUserId: string,
  subjectTraineeId: string,
  listMonth: string,
): Promise<void> {
  const preference = preferredChartsPeriod(accountUserId, subjectTraineeId);
  chartsPeriod = preference.period;
  // The charts keep their own week, month or year apart from the list; only a first visit starts from its month.
  chartsAnchor = preference.anchor ?? monthAnchor(listMonth, today);
  const [range, days] = await Promise.all([
    readMeasurementRange(client, subjectTraineeId, {
      period: chartsPeriod,
      anchor: chartsAnchor,
      years: lastYearsRange(today),
    }),
    readMeasurementDays(client, subjectTraineeId),
  ]);
  chartInitial = range.ok ? { entries: range.entries, window: range.window } : null;
  chartDays = days.ok ? days.days : null;
}

if (supabase && user) {
  const requestedRole = requestedRoleFromMetadata(user.user_metadata);
  if (requestedRole !== "reject") {
    const ensured = await ensureProfile(supabase, user.id, requestedRole);
    if (ensured.ok) {
      role = ensured.role;
      if (role === "trainee") {
        traineeAccountId = user.id;
        const editId = Astro.url.searchParams.get("edit");
        const deleteId = Astro.url.searchParams.get("delete");
        const listed = await readMeasurementPage(supabase, user.id, {
          month: preferredMonth(user.id, user.id),
          page: preferredJournalPage(user.id, user.id),
          pageSize: preferredPageSize(user.id),
          focusId: deleteId ?? editId,
          now,
        });
        measurementsLoaded = listed.ok;
        if (listed.ok) {
          entries = listed.entries;
          dates = listed.dates;
          page = listed.page;
          pageCount = listed.pageCount;
          pageSize = listed.pageSize;
          month = listed.month;
        }
        if (listed.ok && editId === null) {
          await readInitialChart(supabase, user.id, user.id, month);
        }
        if (editId !== null) {
          const loaded = await getMeasurement(supabase, user.id, editId);
          editingEntry = loaded.ok ? loaded.entry : null;
          if (editingEntry === null) {
            traineeServerError = serverError ?? "Could not open that measurement";
          }
        }
        if (deleteId !== null) {
          const loaded = await getMeasurement(supabase, user.id, deleteId);
          confirmingEntry = loaded.ok ? loaded.entry : null;
          if (confirmingEntry === null) {
            traineeServerError = serverError ?? "Could not delete the measurement";
          }
        }
      } else {
        trainerAccountId = user.id;
        requestedEmail = requestedNoticeEmail(requestedParam);
        const listedLinks = await listTrainerLinks(supabase);
        trainerLinksLoaded = listedLinks.ok;
        if (listedLinks.ok) {
          const rememberedTrainee = cookieValue(selectedTraineeStorageKey(user.id));
          const requestedTrainee = preferredTraineeId(traineeParam, rememberedTrainee);
          const preview = selectTrainerPreview(listedLinks.links, requestedTrainee);
          trainerLinks = preview.links;
          selectedLink = preview.selected;
          if (selectedLink !== null && traineeParam === selectedLink.traineeId) {
            Astro.cookies.set(selectedTraineeStorageKey(user.id), selectedLink.traineeId, {
              path: "/",
              maxAge: 31536000,
              sameSite: "lax",
              httpOnly: true,
            });
          }
          if (selectedLink) {
            const listed = await readMeasurementPage(supabase, selectedLink.traineeId, {
              month: preferredMonth(user.id, selectedLink.traineeId),
              page: preferredJournalPage(user.id, selectedLink.traineeId),
              pageSize: preferredPageSize(user.id),
              focusId: null,
              now,
            });
            trainerMeasurementsLoaded = listed.ok;
            if (listed.ok) {
              entries = listed.entries;
              dates = listed.dates;
              page = listed.page;
              pageCount = listed.pageCount;
              pageSize = listed.pageSize;
              month = listed.month;
              await readInitialChart(supabase, user.id, selectedLink.traineeId, month);
            }
          }
        }
      }
    }
  }
}
---

<Layout title="Measurements" measurementChrome>
  <div class="flex justify-center px-4 pt-2">
    <div class="w-full max-w-measurement">
      <Topbar />
    </div>
  </div>
  {role === "trainee" ? (
    <TraineeJournal
      measurementsLoaded={measurementsLoaded}
      entries={entries}
      serverError={traineeServerError}
      notice={measurementNotice}
      editingEntry={editingEntry}
      confirmingEntry={confirmingEntry}
      accountUserId={traineeAccountId}
      subjectTraineeId={traineeAccountId}
      addFormOpen={traineeAccountId ? preferredAddForm(traineeAccountId) : null}
      chartsOpen={traineeAccountId ? preferredChartsOpen(traineeAccountId) : null}
      chartsPeriod={chartsPeriod}
      chartsAnchor={chartsAnchor}
      chartInitial={chartInitial}
      chartDays={chartDays}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
    />
  ) : (
    <TrainerPanel
      mode={role === "trainer" ? "trainer" : "unavailable"}
      serverError={serverError}
      requestedEmail={requestedEmail}
      trainerLinksLoaded={trainerLinksLoaded}
      trainerLinks={trainerLinks}
      selectedLink={selectedLink}
      trainerMeasurementsLoaded={trainerMeasurementsLoaded}
      entries={entries}
      accountUserId={trainerAccountId}
      chartsOpen={trainerAccountId ? preferredChartsOpen(trainerAccountId) : null}
      chartsPeriod={chartsPeriod}
      chartsAnchor={chartsAnchor}
      chartInitial={chartInitial}
      chartDays={chartDays}
      today={today}
      dates={dates}
      page={page}
      pageCount={pageCount}
      pageSize={pageSize}
      month={month}
    />
  )}
</Layout>
