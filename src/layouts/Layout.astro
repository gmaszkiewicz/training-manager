---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Footer from "@/components/Footer.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Gray canvas, with the menu, content, and footer in one column. */
  measurementChrome?: boolean;
}

const { title = "10x Astro Starter", measurementChrome = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      // Duplicates THEME_STORAGE_KEY and resolveTheme from src/lib/theme.ts; keep the key and values in sync.
      (function () {
        var preference = "system";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark" || stored === "system") preference = stored;
        } catch (e) {
          preference = "system";
        }
        var dark =
          preference === "dark" ||
          (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class:list={["flex min-h-screen flex-col", measurementChrome && "bg-canvas"]}>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <div class:list={["flex flex-col", !measurementChrome && "flex-1"]}>
      <slot />
    </div>
    <div class:list={[measurementChrome ? "flex justify-center px-4 pb-2" : "px-4 pb-2 sm:px-8"]}>
      {measurementChrome ? (
        <div class="w-full max-w-measurement">
          <Footer />
        </div>
      ) : (
        <Footer />
      )}
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  html {
    scrollbar-gutter: stable;
    overflow-x: clip;
  }
</style>
